# IDE
.idea/
.vs/

# Node Modules
node_modules/
npm-debug.log
foundry.js

# ...except the official Foundry CLI vendored under scripts/pack-tools. It is committed
# on purpose: the machines that use it have no npm, so its dependencies have to travel
# with the repo. They are real copies, never links - a junction here once let a "discard
# changes" delete files inside the Foundry installation itself.
!scripts/pack-tools/fvtt-cli/node_modules/
!scripts/pack-tools/fvtt-cli/node_modules/**

# The JSON extracted from a pack is a working copy; the .ldb files are the source.
/packs/_source/

# Release
system.zip
foundry-0.8.3.js

# FoundryVTT Packs - ignore database files but keep source
/packs/**/_source/*
/packs/*.json
/packs/.gitignore
/packs/README.md

# FoundryVTT Pack Database Files
#
# Upstream PTR ignores the whole LevelDB because it BUILDS its packs at release time.
# This fork authors content directly in Foundry, so the database IS the source: ignoring
# it meant 15 of 17 packs had no data in git at all. The consistent set (.ldb + .log +
# CURRENT + MANIFEST) is now tracked so a clone gets working compendiums, and so the
# GitHub remote doubles as the backup.
#
# Only the genuinely runtime-only files stay ignored - LevelDB regenerates these.
/packs/**/LOG
/packs/**/LOG.old
/packs/**/LOCK
/packs/**/lost/
/packs/**/*.old

app/
client
common

# OS / editor scratch
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.tmp
*~
