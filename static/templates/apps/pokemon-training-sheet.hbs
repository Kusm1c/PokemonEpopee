<form onsubmit="_updateObject()" class="{{cssClass}} container-fluid" autocomplete="off">
    <div class="d-flex flex-column w-100 h-100">
        {{#if trainer}}
            <div class="d-flex flex-column mb-2 trainer">
                <h3>{{localize "PTU.Epopee.Modifiers.Trainer"}}</h3>
                <div class="d-flex flex-row party-list">
                    <div class="party-item" data-actor-uuid="{{trainer.uuid}}">
                        <img src="{{trainer.img}}" alt="{{trainer.name}}" title="{{trainer.name}}" />
                        <div class="labels">
                            <label>{{trainer.name}}</label>
                            <small>{{peLocalize "PTU.Epopee.Apps.Party.Level" level=trainer.system.level.current}}</small>
                        </div>
                    </div>
                </div>
            </div>
        {{/if}}
        {{#each boxes as |box name|}}
            <div class="d-flex flex-column mb-2">
                <h3>{{formatSlug name}}<span style="float:right;">{{#if (is name "training")}}{{peLocalize "PTU.Epopee.Apps.Training.Total" instances=box.instances exp=box.xpinstance total=box.metric}}{{else}}{{peLocalize "PTU.Epopee.Apps.Party.AverageLevel" level=box.metric}}{{/if}}</span></h3>
                {{#if (is name "training")}}
                    <div style="text-align: center; margin-bottom: 10px;">
                        <input type="radio" id="none" value="none" name="training" checked="checked">
                        <label for="none">{{localize "PTU.SelectNone"}}</label>
                        <input type="radio" id="agility-training" name="training" value="agility-training">
                        <label for="agility-training">{{peLocalize "PTU.Epopee.Apps.Training.Agility"}}</label>
                        <input type="radio" id="brutal-training" name="training" value="brutal-training">
                        <label for="brutal-training">{{peLocalize "PTU.Epopee.Apps.Training.Brutal"}}</label>
                        <input type="radio" id="focused-training" name="training" value="focused-training">
                        <label for="focused-training">{{peLocalize "PTU.Epopee.Apps.Training.Focused"}}</label>
                        <input type="radio" id="inspired-training" name="training" value="inspired-training">
                        <label for="inspired-training">{{peLocalize "PTU.Epopee.Apps.Training.Inspired"}}</label>
                    </div>
                    <div style="text-align: center; margin-bottom: 10px;">
                        <button type="submit">{{peLocalize "PTU.Epopee.Apps.Training.Train"}}</button>
                    </div>
                {{/if}}
                <div class="d-flex flex-row party-list droppable" data-party-status="{{name}}">
                    {{#each box.contents as |actor|}}
                        <div class="party-item draggable" data-actor-uuid="{{actor.uuid}}" data-party-status="{{#if (is name "training")}}training{{else}}{{#if (is name "party")}}party{{else}}{{#if (is name "available")}}available{{else}}boxed{{/if}}{{/if}}{{/if}}" data-actor-index="{{@index}}">
                            <img src="{{actor.img}}" alt="{{actor.name}}" title="{{actor.name}}" />
                            <div class="labels">
                                <label>{{actor.name}}</label>
                                <small>{{peLocalize "PTU.Epopee.Apps.Party.Level" level=actor.system.level.current}}</small>
                                {{#if (is name "training")}}
                                    <input id="xp-for-{{actor.id}}" name="{{actor.id}}" type="number" style="width: 80px; margin-top: 5px;" placeholder="{{peLocalize "PTU.Epopee.Apps.Training.Instances"}}" min="0">
                                {{/if}}
                            </div>
                        </div>
                    {{/each}}
                    {{#unless box.contents}}
                        <div class="party-item empty">
                            <div class="item-name">
                                <small><i>{{peLocalize "PTU.Epopee.Apps.Party.DropActor"}}</i></small>
                            </div>
                        </div>
                    {{/unless}}
                </div>
            </div>
        {{/each}}
    </div>
</form>
