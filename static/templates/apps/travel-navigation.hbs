<div class="pe-travel">
    {{#unless folderFound}}
    <p class="pe-travel-warning">{{folder}}</p>
    {{else}}
    {{#unless trainers.length}}
    <p class="pe-travel-warning">{{noTrainers}}</p>
    {{/unless}}
    {{/unless}}

    <div class="form-group">
        <label>{{peLocalize "PTU.Epopee.Travel.Navigation.Actor"}}</label>
        <select name="actorId">
            <option value="">—</option>
            {{#each trainers}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label>{{peLocalize "PTU.Epopee.Travel.Navigation.Terrain"}}</label>
        <select name="terrainId">
            {{#each terrains}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
        </select>
    </div>

    <div class="pe-travel-result">
        <span>{{peLocalize "PTU.Epopee.Travel.Navigation.DC"}}</span>
        <b>{{dc}}</b>
    </div>

    <p class="pe-muted">{{peLocalize "PTU.Epopee.Travel.Navigation.Hint"}}</p>

    <button type="button" class="pe-navigation-roll" {{#unless canRoll}}disabled{{/unless}}>
        <i class="fas fa-compass"></i> {{peLocalize "PTU.Epopee.Travel.Navigation.Roll"}}
    </button>
</div>
