<div class="pe-travel">
    <div class="form-group">
        <label>{{peLocalize "PTU.Epopee.Travel.Journey.Pace"}}</label>
        <select name="paceId">
            {{#each paces}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
        </select>
    </div>
    <p class="pe-muted">{{paceEffect}}</p>

    <div class="form-group">
        <label>{{peLocalize "PTU.Epopee.Travel.Journey.Terrain"}}</label>
        <select name="terrainId">
            {{#each terrains}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
        </select>
    </div>
    <div class="form-group">
        <label>{{peLocalize "PTU.Epopee.Travel.Journey.Path"}}</label>
        <select name="pathId">
            {{#each paths}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
        </select>
    </div>
    <div class="form-group">
        <label>{{peLocalize "PTU.Epopee.Travel.Journey.Condition"}}</label>
        <select name="conditionId">
            {{#each conditions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
        </select>
    </div>
    <div class="form-group">
        <label>{{peLocalize "PTU.Epopee.Travel.Journey.Duration"}}</label>
        <select name="hours">
            {{#each hours}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
        </select>
    </div>

    <table class="pe-journey-preview">
        <tr><th>{{peLocalize "PTU.Epopee.Travel.Journey.Pace"}}</th><td>{{peLocalize "PTU.Epopee.Travel.Journey.KmPerHour" value=preview.base}}</td></tr>
        <tr><th>{{peLocalize "PTU.Epopee.Travel.Journey.Terrain"}}</th><td>{{preview.terrain}}</td></tr>
        <tr><th>{{peLocalize "PTU.Epopee.Travel.Journey.Condition"}}</th><td>{{preview.condition}}</td></tr>
        <tr><th>{{peLocalize "PTU.Epopee.Travel.Journey.FinalPace"}}</th><td>{{peLocalize "PTU.Epopee.Travel.Journey.KmPerHour" value=preview.pace}}</td></tr>
        <tr><th>{{peLocalize "PTU.Epopee.Travel.Journey.Duration"}}</th><td>{{peLocalize "PTU.Epopee.Travel.Journey.Hours" hours=preview.hours}}</td></tr>
        <tr class="pe-journey-total"><th>{{peLocalize "PTU.Epopee.Travel.Journey.Distance"}}</th><td>{{preview.km}} km</td></tr>
    </table>

    <button type="button" class="pe-journey-confirm" {{#unless canConfirm}}disabled{{/unless}}>
        <i class="fas fa-route"></i> {{peLocalize "PTU.Epopee.Travel.Journey.Confirm"}}
    </button>
</div>
