{{!-- Epopee: the common moves (Lutte, Garde, Réaction...) from the Moves compendium, shown
     like any move. They are not embedded on the actor, so there is nothing to edit or delete
     here: `.rollable.move` and the name's summary find them through the attacks by realId. --}}
<ol class="item-list move-list pl-1">
    {{#each commons as |entry|}}
    <li class="item common-move-item" data-item-id="{{entry.id}}"{{#if entry.locked}} style="opacity:.55;"{{/if}}>
        <div class="item-icon {{#unless entry.locked}}rollable{{/unless}} move">
            <img class="icon" src="{{entry.item.img}}" title="{{entry.item.name}}"/>
            {{#unless entry.locked}}
            <img class="dice" src="/icons/svg/d20.svg" title="{{peLocalize "PTU.Epopee.ItemList.Roll" name=entry.item.name}}">
            {{/unless}}
        </div>
        <div class="move-info">
            <div class="item-name">
                <h4>{{entry.item.name}}</h4>
            </div>
            <div class="item-tags">
                {{#if entry.locked}}
                <div class="tag shadowless tooltip" title="{{entry.hint}}">
                    <i class="fas fa-lock"></i>
                </div>
                {{/if}}
            </div>
            <div class="item-controls">
                <a class="item-control item-to-chat" title="{{peLocalize "PTU.Epopee.ItemList.SendToChat" type=(localize (concat "TYPES.Item." entry.item.type))}}"><i class="fas fa-external-link-alt"></i></a>
            </div>
            <div class="move-tags">
                {{#if entry.status}}
                <div class="tag gradient">
                    <span>{{entry.status}}</span>
                </div>
                {{/if}}
                {{> "systems/pe/static/templates/partials/move-tags.hbs" item=entry.item actor=../actor}}
            </div>
        </div>
    </li>
    {{else}}
    <li class="center-text p-1" style="font-size:11px;opacity:.6;">{{peLocalize "PTU.Epopee.CommonMoves.None"}}</li>
    {{/each}}
</ol>
