<div class="item-list-header p-1">
    {{#if hint}}
    <h3 class="title" data-tooltip="{{hint}}">{{title}} <i class="fas fa-circle-info" style="font-size: 0.7em; opacity: 0.6;"></i></h3>
    {{else}}
    <h3 class="title">{{title}}</h3>
    {{/if}}
    {{#if featsOrEdges}}
        <!-- Display the amount / max of feats or edges -->
        <div class="item-amount">
            <h4 class="mr-1 mb-0">{{peLocalize "PTU.Epopee.ItemList.SlotsUsed"}}</h4>
            <input type="text" value="{{featsOrEdges.total}}" data-dtype="Number" disabled/>
            <span class="mr-1 ml-1"> / </span>
            <input type="text" value="{{featsOrEdges.max}}" data-dtype="Number" disabled/>
        </div>
    {{/if}}
    {{#unless (or (is type "effect") (is type "condition"))}}
        {{#unless no-add}}
            <div class="item-controls">
                {{#if settings}}
                    <a class="item-control item-settings center-self mr-1" title="{{peLocalize "PTU.Epopee.ItemList.Settings"}}" data-setting="{{settings}}"><i class="fas fa-cog"></i></a>
                {{/if}}
                <!-- possibly replace / add a 'browse' button here -->
                <a class="item-control item-create" title="{{peLocalize "PTU.Epopee.ItemList.Add" type=(localize (concat "TYPES.Item." type))}}" data-type="{{type}}" data-category="{{category}}">
                    <i class="fas fa-plus-circle" style="margin-right: 3px;"></i>
                    <span class="readable">{{localize "ITEM.AddButton"}}</span>
                </a>
            </div>
        {{/unless}}
    {{/unless}}
</div>
{{#if (is type "move")}}
    <ol class="item-list move-list pl-1">
        {{#each items as | item |}}
            <li class="item {{item.type}}-item{{#if (usageExhausted item)}} usage-exhausted{{/if}}" data-item-id="{{item.realId}}">
                <div class="item-icon {{#if item.rollable}}rollable{{/if}} move">
                    <img class="icon" src="{{item.img}}" title="{{item.name}}"/>
                    <img class="dice" src="/icons/svg/d20.svg" title="{{peLocalize "PTU.Epopee.ItemList.Roll" name=item.name}}">
                </div>
                <div class="move-info">
                    <div class="item-name">
                        <h4>{{item.name}}</h4>
                    </div>
                    <div class="item-tags">
                        {{#if item.grantedBy}}
                            <div class="tag shadowless tooltip" title="{{peLocalize "PTU.Epopee.ItemList.GrantedBy" name=item.grantedBy.name}}">
                                <img src="/systems/pe/static/css/images/icons/granted_icon.png"/>
                            </div>
                        {{/if}}
                        {{#if item.hasAutomation}}
                            {{#if item.enabled}}
                                <div class="tag shadowless tooltip" title="{{peLocalize "PTU.Epopee.ItemList.HasAutomation"}}">
                                    <img src="/systems/pe/static/css/images/icons/automated_icon.png"/>
                                </div>
                            {{else}}
                                <div class="tag shadowless tooltip" title="{{peLocalize "PTU.Epopee.ItemList.DisabledAutomation"}}">
                                    <img src="/systems/pe/static/css/images/icons/automated_disabled_icon.png" style="opacity: 0.5"/>
                                </div>
                            {{/if}}
                        {{/if}}
                    </div>
                    <div class="item-controls">
                        {{#unless ../no-add}}
                            {{#if item.hasAutomation}}
                                <a class="item-control item-enable" title="{{#if item.enabled}}{{peLocalize "PTU.Epopee.ItemList.DisableAutomation"}}{{else}}{{peLocalize "PTU.Epopee.ItemList.EnableAutomation"}}{{/if}}">{{#if item.enabled}}<i class="fas fa-toggle-on"></i>{{else}}<i class="fas fa-toggle-off"></i>{{/if}}</a>
                            {{/if}}
                            <a class="item-control item-to-chat" title="{{peLocalize "PTU.Epopee.ItemList.SendToChat" type=(localize (concat "TYPES.Item." item.type))}}"><i class="fas fa-external-link-alt"></i></a>
                            <a class="item-control item-edit" title="{{peLocalize "PTU.Epopee.ItemList.Edit" type=(localize (concat "TYPES.Item." item.type))}}"><i class="fas fa-edit"></i></a>
                            <a class="item-control item-delete" title="{{peLocalize "PTU.Epopee.ItemList.Delete" type=(localize (concat "TYPES.Item." item.type))}}"><i class="fas fa-trash"></i></a>
                        {{/unless}}
                    </div>
                    <div class="move-tags">
                        {{> "systems/pe/static/templates/partials/move-tags.hbs" item=item actor=../actor}}
                    </div>
                </div>
            </li>
        {{/each}}
        <ol class="nested-items"></ol> <!-- Implement Nested Items -->
    </ol> 
{{else}}
    <ol class="item-list pl-1" {{#if category}}data-category="{{category}}"{{/if}}>
        {{#each items as | item |}}
            {{#unless (and item.grantedBySameType (notEqual type "condition"))}}
        <li class="item {{item.type}}-item {{#if (is item.active false)}}disabled{{/if}}" data-item-id="{{item._id}}">
                    {{#if item.rollable}}
                        <div class="item-icon rollable">
                            <img class="icon" src="{{item.img}}" title="{{item.name}} ({{localize (concat "TYPES.Item." item.type)}})"/>
                            <img class="dice" src="/icons/svg/d20.svg" title="{{peLocalize "PTU.Epopee.ItemList.Roll" name=item.name}}">
                        </div>
                    {{else}}
                        <div class="item-icon">
                            <img class="icon" src="{{item.img}}" title="{{item.name}} ({{localize (concat "TYPES.Item." item.type)}})"/>
                        </div>
                    {{/if}}
                    <div class="item-info">
                        <div class="item-name">
                            <h4>{{item.name}}</h4>
                        </div>
                        <div class="item-tags">
                            {{#if item.isOverriden}}
                                <div class="tag shadowless tooltip" title="{{peLocalize "PTU.Epopee.ItemList.ConditionOverridden"}}">
                                    <i class="fa-solid fa-lock"></i>
                                </div>
                            {{/if}}
                            {{#if item.isGranted}}
                                <div class="tag shadowless tooltip" title="{{peLocalize "PTU.Epopee.ItemList.GrantedBy" name=item.grantedBy.name}}">
                                    <img src="/systems/pe/static/css/images/icons/granted_icon.png"/>
                                </div>
                            {{/if}}
                            {{#unless (or (is type "effect") (is type "condition"))}}
                                {{#if item.hasAutomation}}
                                    {{#if item.enabled}}
                                        <div class="tag shadowless tooltip" title="{{peLocalize "PTU.Epopee.ItemList.HasAutomation"}}">
                                            <img src="/systems/pe/static/css/images/icons/automated_icon.png"/>
                                        </div>
                                    {{else}}
                                        <div class="tag shadowless tooltip" title="{{peLocalize "PTU.Epopee.ItemList.DisabledAutomation"}}">
                                            <img src="/systems/pe/static/css/images/icons/automated_disabled_icon.png" style="opacity: 0.5"/>
                                        </div>
                                    {{/if}}
                                {{/if}}
                            {{/unless}}
                        </div>
                        {{#if item.system.quantity includeZero=true}}
                            <div class="item-quantity">
                                <input class="ml-1 mr-1" data-item-id="{{item.id}}" data-binding="system.quantity" type="number" value="{{item.system.quantity}}" placeholder="{{localize "ITEM.Quantity"}}"/>
                            </div>
                        {{/if}}
                        <div class="item-controls">
                            {{#if item.grants}}
                                <a class="item-control collapse-sub-items" title="{{peLocalize "PTU.Epopee.ItemList.CollapseSubItems"}}"><i class="fas fa-minus-square"></i></a>
                            {{/if}}
                            {{#if (is item.type "item")}}
                                <a class="item-control item-enable" title="{{#if item.enabled}}{{peLocalize "PTU.Epopee.ItemList.Unequip"}}{{else}}{{peLocalize "PTU.Epopee.ItemList.Equip"}}{{/if}}">{{#if item.enabled}}<i class="fas fa-shirt"></i>{{else}}<i class="fas fa-grip-lines"></i>{{/if}}</a>
                            {{else}}
                                <a class="item-control item-enable" title="{{#if item.enabled}}{{peLocalize "PTU.Epopee.ItemList.DisableAutomation"}}{{else}}{{peLocalize "PTU.Epopee.ItemList.EnableAutomation"}}{{/if}}">{{#if item.enabled}}<i class="fas fa-toggle-on"></i>{{else}}<i class="fas fa-toggle-off"></i>{{/if}}</a>
                            {{/if}}
                            <a class="item-control item-to-chat" title="{{peLocalize "PTU.Epopee.ItemList.SendToChat" type=(localize (concat "TYPES.Item." item.type))}}"><i class="fas fa-external-link-alt"></i></a>
                            {{#unless (is item.type "condition")}}
                                <a class="item-control item-edit" title="{{peLocalize "PTU.Epopee.ItemList.Edit" type=(localize (concat "TYPES.Item." item.type))}}"><i class="fas fa-edit"></i></a>
                            {{/unless}}
                            <a class="item-control item-delete" title="{{peLocalize "PTU.Epopee.ItemList.Delete" type=(localize (concat "TYPES.Item." item.type))}}"><i class="fas fa-trash"></i></a>
                        </div>
                    </div>
                    {{> grantedFeats parent=item}}
                </li>
            {{/unless}}
        {{/each}}
    </ol>       
{{/if}}

{{#*inline "grantedFeats"}}
    {{#if parent.grants}}
    <ol class="nested-items show">
        {{#each parent.grants as |item|}}
            <li class="item {{item.type}}-item" data-item-id="{{item._id}}">
                {{#if (and system.frequency (notEqual system.frequency "Static"))}}
                    <div class="item-icon rollable">
                        <img class="icon" src="{{item.img}}" title="{{item.name}} ({{localize (concat "TYPES.Item." item.type)}})"/>
                        <img class="dice" src="/icons/svg/d20.svg" title="{{peLocalize "PTU.Epopee.ItemList.Roll" name=item.name}}">
                    </div>
                {{else}}
                    <div class="item-icon">
                        <img class="icon" src="{{item.img}}" title="{{item.name}} ({{localize (concat "TYPES.Item." item.type)}})"/>
                    </div>
                {{/if}}
                <div class="item-info">
                    <div class="item-name">
                        <h4>{{item.name}}</h4>
                    </div>
                    <div class="item-tags">
                        {{#if item.isGranted}}
                            <div class="tag shadowless tooltip" title="{{peLocalize "PTU.Epopee.ItemList.GrantedBy" name=item.grantedBy.name}}">
                                <img src="/systems/pe/static/css/images/icons/granted_icon.png"/>
                            </div>
                        {{/if}}
                        {{#if item.system.rules}}
                            {{#if item.enabled}}
                                <div class="tag shadowless tooltip" title="{{peLocalize "PTU.Epopee.ItemList.HasAutomation"}}">
                                    <img src="/systems/pe/static/css/images/icons/automated_icon.png"/>
                                </div>
                            {{else}}
                                <div class="tag shadowless tooltip" title="{{peLocalize "PTU.Epopee.ItemList.DisabledAutomation"}}">
                                    <img src="/systems/pe/static/css/images/icons/automated_disabled_icon.png" style="opacity: 0.5"/>
                                </div>
                            {{/if}}
                        {{/if}}
                    </div>
                    {{#if item.system.quantity}}
                        <div class="item-quantity">
                            <input class="ml-1 mr-1" data-item-id="{{item.id}}" data-binding="system.quantity" type="number" value="{{item.system.quantity}}" placeholder="{{localize "ITEM.Quantity"}}"/>
                        </div>
                    {{/if}}
                    <div class="item-controls">
                        {{#if (is item.type "item")}}
                            <a class="item-control item-enable" title="{{#if item.enabled}}{{peLocalize "PTU.Epopee.ItemList.Unequip"}}{{else}}{{peLocalize "PTU.Epopee.ItemList.Equip"}}{{/if}}">{{#if item.enabled}}<i class="fas fa-shirt"></i>{{else}}<i class="fas fa-grip-lines"></i>{{/if}}</a>
                        {{else}}
                            <a class="item-control item-enable" title="{{#if item.enabled}}{{peLocalize "PTU.Epopee.ItemList.DisableAutomation"}}{{else}}{{peLocalize "PTU.Epopee.ItemList.EnableAutomation"}}{{/if}}">{{#if item.enabled}}<i class="fas fa-toggle-on"></i>{{else}}<i class="fas fa-toggle-off"></i>{{/if}}</a>
                        {{/if}}
                        <a class="item-control item-to-chat" title="{{peLocalize "PTU.Epopee.ItemList.SendToChat" type=(localize (concat "TYPES.Item." item.type))}}"><i class="fas fa-external-link-alt"></i></a>
                        <a class="item-control item-edit" title="{{peLocalize "PTU.Epopee.ItemList.Edit" type=(localize (concat "TYPES.Item." item.type))}}"><i class="fas fa-edit"></i></a>
                        <a class="item-control item-delete" title="{{peLocalize "PTU.Epopee.ItemList.Delete" type=(localize (concat "TYPES.Item." item.type))}}"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
                {{> grantedFeats parent=item}}
            </li>
        {{/each}}
    </ol>
    {{/if}}
{{/inline}}