<form class="{{cssClass}} container-fluid" autocomplete="off">

    <div class="ball-themes element background {{ballStyle}}"></div>
    <div class="ball-themes element gradient {{ballStyle}}"></div>
    <!-- Highlight Shape JS insert -->
    <div class="ball-themes element light-color {{ballStyle}}"></div>
    <div class="ball-themes element band {{ballStyle}}"></div>

    <header class="sheet-header sheet-tabs ball-themes background {{ballStyle}}" data-group="primary">
        <nav class="tabs" data-group="primary">
            {{!-- Epopee: four tabs, in the order the design calls for - the same as the
                  Pokemon sheet. Statistics keeps the internal id `stats` because
                  character/sheet.js declares it as the `initial` tab. --}}
            <a class="item tooltip ball-themes {{ballStyle}}" title="{{localize "PTU.Epopee.TabStatistics"}}" data-tab="stats"><i class="fas fa-bars-progress"></i></a>
            <a class="item tooltip ball-themes {{ballStyle}}" title="{{localize "PTU.Epopee.TabActions"}}" data-tab="actions"><i class="fas fa-burst"></i></a>
            <a class="item tooltip ball-themes {{ballStyle}}" title="{{localize "PTU.Epopee.TabNarrative"}}" data-tab="narrative"><i class="fas fa-feather"></i></a>
            <a class="item tooltip ball-themes {{ballStyle}}" title="{{localize "PTU.Epopee.TabMechanics"}}" data-tab="extra"><i class="fas fa-gear"></i></a>
        </nav>
    </header>
    <main class="sheet-body h-100">
        <!-- Statistics -->
        <div class="tab details stats pe-tab" data-group="primary" data-tab="stats">
            <div class="pe-layout">
            <div class="pe-col pe-col-main">
                <div class="swsh-box level-box" style="text-align: center;">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight p-1 justify-content-center align-items-center" style="gap: 8px;">
                        <label for="system.level.current">{{localize "PTU.Level"}}:</label>
                        <input class="p-0 pe-level" type="text" name="system.level.current"
                            value="{{actor.system.level.current}}" data-dtype="Number" disabled />
                    </div>
                    <div class="swsh-header ball-themes {{ballStyle}} highlight">
                        <div class="d-flex w-100 mt-2 mb-2 align-items-center justify-content-between">
                            <div class="pe-cell">
                                <label for="system.level.milestones"><b>{{localize "PTU.LevelMilestones"}}</b></label>
                            </div>
                            {{#if (is true (getGameSetting "variant.useDexExp"))}}
                            <div class="pe-cell">
                                <label for="system.level.dexexp"><b>{{localize "PTU.LevelDexExp"}}</b></label>
                            </div>
                            {{/if}}
                            <div class="pe-cell">
                                <label for="system.level.miscexp"><b>Expérience</b></label>
                            </div>
                            <div class="pe-cell" title="STAB = 5 + (Niveau / 5)">
                                <b>STAB</b>
                            </div>
                        </div>
                    </div>
                    <div class="swsh-body">
                        <div class="d-flex w-100 pt-1 pb-1 align-items-center justify-content-between center-text">
                            <div class="pe-cell">
                                <input type="number" name="system.level.milestones" value="{{actor.system.level.milestones}}" data-dtype="Number" />
                            </div>
                            {{#if (is true (getGameSetting "variant.useDexExp"))}}
                            <div class="pe-cell">
                                <input type="number" name="system.level.dexexp" value="{{actor.system.level.dexexp}}" data-dtype="Number" disabled />
                            </div>
                            {{/if}}
                            <div class="pe-cell">
                                <input type="number" name="system.level.miscexp" value="{{actor.system.level.miscexp}}" data-dtype="Number" />
                            </div>
                            <div class="pe-cell">
                                <b style="font-size: 16px;">{{epopee.stab}}</b>
                            </div>
                        </div>
                    </div>
                    {{#if epopee.pending.any}}
                    <div class="swsh-body center-text pt-1 pb-1"
                        style="background:#e8b923;color:#000;font-size:11px;font-weight:bold;">
                        À faire :
                        {{#if epopee.pending.stats}}{{epopee.pending.stats}} stat(s) à répartir. {{/if}}
                        {{#if epopee.pending.featsLeft}}{{epopee.pending.featsLeft}} feature(s) à placer. {{/if}}
                        {{#if epopee.pending.edgesLeft}}{{epopee.pending.edgesLeft}} edge(s) à choisir.{{/if}}
                    </div>
                    {{/if}}
                </div>

                <div class="swsh-box">
                    <div class="swsh-body pt-3 p-2">
                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs" title=(localize
                            "TYPES.Item.conditionPlural") type="condition" items=conditions}}
                    </div>
                    <div class="swsh-body pt-3 p-2">
                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs" title=(localize
                            "TYPES.Item.effectPlural") type="effect" items=effects}}
                    </div>
                </div>

                <div class="combat">
                    <div class="w-100 stats swsh-box mb-2">
                        <div class="d-flex flex-row swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2">
                            <div class="fb-20 pt-2 pb-2 key stat-header">{{localize "PTU.StatsLabel"}}</div>
                            <div class="fb-15 mt-2 mb-2">{{localize "PTU.StatsBase"}}</div>
                            <div class="fb-20 mt-2 mb-2">{{localize "PTU.StatsLevelup"}}</div>
                            <div class="fb-15 mt-2 mb-2">{{localize "PTU.StatsMod"}}</div>
                            <div class="fb-15 mt-2 mb-2">{{localize "PTU.StatsStage"}}</div>
                            <div class="fb-15 mt-2 mb-2">{{localize "PTU.StatsTotal"}}</div>
                            <div class="fb-10 mt-2 mb-2" title="{{localize "PTU.Epopee.Fragment"}}">Frag</div>
                            <div class="fb-25 mt-2 mb-2" title="{{localize "PTU.Epopee.CombatStages"}}">MdS</div>
                        </div>
                        <div class="swsh-body p-0">
                            {{#each actor.system.stats as |stat key|}}
                                <div class="d-flex flex-row {{key}}">
                                    <div class="stats {{key}} key fb-20">
                                        <label for="system.stats.{{key}}.value" class="resource-label">{{key}}</label>
                                    </div>
                                    <div class="stats {{key}} base fb-15">
                                        <input type="number" name="system.stats.{{key}}.value" value="{{stat.value}}"
                                            data-dtype="Number" disabled />
                                    </div>
                                    <div class="stats {{key}} levelUp fb-20">
                                        {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                        path=(concat "system.stats." key ".levelUp")
                                        value=stat.levelUp
                                        dtype="Number"
                                        mod=""
                                        total="ignored"
                                        modOrigins=(getProperty ../actor.origins (concat "system.stats." key
                                        ".levelUp"))
                                        flipped=(gt 3 @index)}}
                                    </div>
                                    <div class="stats {{key}} mod fb-15">
                                        {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                        mod=stat.mod.mod
                                        path=(concat "system.stats." key ".mod.value")
                                        value=stat.mod.value
                                        total="ignored"
                                        dtype="Number"
                                        modOrigins=(getProperty ../actor.origins (concat "system.stats." key
                                        ".mod.mod"))
                                        flipped=(gt 3 @index)}}
                                    </div>
                                    <div class="stats stage stage fb-15">
                                        {{#if (isdefined stat.stage)}}
                                        {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                        mod=stat.stage.mod
                                        path=(concat "system.stats." key ".stage.value")
                                        value=stat.stage.value
                                        total="ignored"
                                        dtype="Number"
                                        modOrigins=(getProperty ../actor.origins (concat "system.stats." key
                                        ".stage.mod"))
                                        flipped=(gt 3 @index)}}
                                        {{/if}}
                                    </div>
                                    <div class="stats {{key}} total fb-15">
                                        <input type="number" name="system.stats.{{key}}.total" value="{{stat.total}}"
                                            data-dtype="Number" disabled />
                                    </div>
                                    <div class="stats {{key}} fragment fb-10 center-text" title="Fragment de {{key}}">
                                        {{#if (lookup ../epopee.fragments key)}}<b>{{lookup ../epopee.fragments key}}</b>
                                        {{else}}<span style="opacity:.4;">-</span>{{/if}}
                                    </div>
                                    <div class="stats {{key}} mds fb-25">
                                        {{#with (lookup ../epopee.gauges key) as |gauge|}}
                                        <div class="d-flex flex-column" style="gap:1px;" title="MdS : {{gauge.current}} ({{gauge.dice}})">
                                            <div class="d-flex" style="gap:1px;">
                                                {{#each gauge.positive as |cell|}}
                                                <span class="mds-cell" data-stat="{{key}}" data-index="{{cell.index}}"
                                                    style="width:10px;height:10px;border:1px solid #666;display:inline-block;cursor:pointer;background:{{#if cell.filled}}#4caf50{{else}}#fff{{/if}};"></span>
                                                {{/each}}
                                            </div>
                                            <div class="d-flex" style="gap:1px;">
                                                {{#each gauge.negative as |cell|}}
                                                <span class="mds-cell" data-stat="{{key}}" data-index="{{cell.index}}"
                                                    style="width:10px;height:10px;border:1px solid #666;display:inline-block;cursor:pointer;background:{{#if cell.filled}}#e05555{{else}}#fff{{/if}};"></span>
                                                {{/each}}
                                            </div>
                                        </div>
                                        {{/with}}
                                    </div>
                                </div>
                            {{/each}}

                            {{!-- Epopee: PRE and ESQ sit below the six main stats and
                                  deliberately have no Level-Up column - they are not
                                  bought with stat points. They live under
                                  system.secondaryStats rather than system.stats so the
                                  loop above cannot pick them up and give them one.
                                  Same block as the Pokemon sheet: the stats are shared
                                  by both actor types via the `stats` template. --}}
                            {{#each actor.system.secondaryStats as |stat key|}}
                                <div class="d-flex flex-row {{key}}">
                                    <div class="stats {{key}} key fb-20">
                                        <label for="system.secondaryStats.{{key}}.value" class="resource-label"
                                            title="{{localize stat.labelKey}}">{{localize stat.abbrKey}}</label>
                                    </div>
                                    <div class="stats {{key}} base fb-15">
                                        <input type="number" name="system.secondaryStats.{{key}}.value"
                                            value="{{stat.value}}" data-dtype="Number" />
                                    </div>
                                    {{!-- Empty cell where Level-Up would be. --}}
                                    <div class="fb-20 center-text" style="opacity:.3;">&mdash;</div>
                                    <div class="stats {{key}} mod fb-15">
                                        {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                        mod=stat.mod.mod
                                        path=(concat "system.secondaryStats." key ".mod.value")
                                        value=stat.mod.value
                                        total="ignored"
                                        dtype="Number"
                                        modOrigins=(getProperty ../actor.origins (concat "system.secondaryStats." key
                                        ".mod.mod"))}}
                                    </div>
                                    <div class="stats stage stage fb-15">
                                        {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                        mod=stat.stage.mod
                                        path=(concat "system.secondaryStats." key ".stage.value")
                                        value=stat.stage.value
                                        total="ignored"
                                        dtype="Number"
                                        modOrigins=(getProperty ../actor.origins (concat "system.secondaryStats." key
                                        ".stage.mod"))}}
                                    </div>
                                    <div class="stats {{key}} total fb-15">
                                        <input type="number" name="system.secondaryStats.{{key}}.total"
                                            value="{{stat.total}}" data-dtype="Number" disabled />
                                    </div>
                                    {{!-- No Fragment: PRE/ESQ are accuracy modifiers, not
                                          values a Fragment is ever taken of. --}}
                                    <div class="fb-10 center-text"><span style="opacity:.3;">&mdash;</span></div>
                                    <div class="stats {{key}} mds fb-25">
                                        {{!-- Epopee: same gauge as the six stats; a click sets secondaryStats.<key>.stage. --}}
                                        {{#with (lookup ../epopee.secondaryGauges key) as |gauge|}}
                                        <div class="d-flex flex-column" style="gap:1px;" title="MdS: {{gauge.current}} ({{gauge.dice}})">
                                            <div class="d-flex" style="gap:1px;">
                                                {{#each gauge.positive as |cell|}}
                                                <span class="mds-cell" data-group="secondaryStats" data-stat="{{key}}" data-index="{{cell.index}}"
                                                    style="width:10px;height:10px;border:1px solid #666;display:inline-block;cursor:pointer;background:{{#if cell.filled}}#4caf50{{else}}#fff{{/if}};"></span>
                                                {{/each}}
                                            </div>
                                            <div class="d-flex" style="gap:1px;">
                                                {{#each gauge.negative as |cell|}}
                                                <span class="mds-cell" data-group="secondaryStats" data-stat="{{key}}" data-index="{{cell.index}}"
                                                    style="width:10px;height:10px;border:1px solid #666;display:inline-block;cursor:pointer;background:{{#if cell.filled}}#e05555{{else}}#fff{{/if}};"></span>
                                                {{/each}}
                                            </div>
                                        </div>
                                        {{/with}}
                                    </div>
                                </div>
                            {{/each}}
                        </div>
                        {{#if actor.system.levelUpPoints}}
                            <div class="d-flex flex-row levelUpPoints center-text align-items-center">
                                <div class="fb-70">
                                    <label for="system.levelUpPoints" class="resource-label">{{localize "PTU.StatsRemainingLevelupPoints"}}:</label>
                                </div>
                                <div class="fb-30">
                                    {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                    path="system.levelUpPoints"
                                    value=actor.system.levelUpPoints
                                    dtype="Number"
                                    mod=""
                                    total=actor.system.levelUpPoints
                                    modOrigins=(getProperty actor.origins "system.levelUpPoints")
                                    disabled=true}}
                                </div>
                            </div>
                        {{/if}}
                    </div>
                </div>

                <div class="combat">
                    {{#if (or (gt effectiveness.weaknesses.length 0) (or (gt effectiveness.resistances.length 0) (gt effectiveness.immunities.length 0)))}}
                    <div class="swsh-box effectiveness mb-2 w-100">
                        <div
                            class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "PTU.Typing"}}</b>
                        </div>
                        <div
                            class="swsh-body mt-1 mb-1 flexrow g-1 p-0 w-100 align-items-center justify-content-center">
                            {{{loadTypeImages actor.types}}}
                        </div>
                        {{#if (gt effectiveness.weaknesses.length 0) }}
                        <div
                            class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "PTU.TypingWeaknesses"}}</b>
                        </div>
                        <div
                            class="swsh-body mt-1 mb-1 flexrow g-5 w-100 align-items-center justify-content-between">
                            {{#each effectiveness.weaknesses as |effectiveness|}}
                            {{!-- {{#each effectiveness as |value type|}} --}}
                            <div class="type-image-effectiveness">
                                {{{loadTypeImages effectiveness.type}}}
                                <span class="ml-1">x{{effectiveness.value}}</span>
                            </div>
                            {{!-- {{/each}} --}}
                            {{/each}}
                        </div>
                        {{/if}}
                        <!-- Hide regular effective moves -->
                        {{!-- {{#if (gt actor.system.effectiveness.Normal.length 0) }}
                        <div
                            class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "PTU.TypingNormal"}}</b>
                        </div>
                        <div class="swsh-body flexrow g-5 w-100 align-items-center">
                            {{#each actor.system.effectiveness.Normal as |effectiveness|}}
                            {{#each effectiveness as |value type|}}
                            <div class="type-image-effectiveness">
                                {{{loadTypeImages type}}}
                                <span class="ml-1">x{{value}}</span>
                            </div>
                            {{/each}}
                            {{/each}}
                        </div>
                        {{/if}} --}}
                        {{#if (gt effectiveness.resistances.length 0) }}
                        <div
                            class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "PTU.TypingResistances"}}</b>
                        </div>
                        <div
                            class="swsh-body mt-1 mb-1 flexrow g-5 w-100 align-items-center justify-content-between">
                            {{#each effectiveness.resistances as |effectiveness|}}
                            {{!-- {{#each effectiveness as |value type|}} --}}
                            <div class="type-image-effectiveness">
                                {{{loadTypeImages effectiveness.type}}}
                                <span class="ml-1">x{{effectiveness.value}}</span>
                            </div>
                            {{!-- {{/each}} --}}
                            {{/each}}
                        </div>
                        {{/if}}
                        {{#if (gt effectiveness.immunities.length 0) }}
                        <div
                            class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "PTU.TypingImmunities"}}</b>
                        </div>
                        <div
                            class="swsh-body mt-1 mb-1 flexrow g-5 w-100 align-items-center justify-content-between">
                            {{#each effectiveness.immunities as |effectiveness|}}
                            {{!-- {{#each effectiveness as |value type|}} --}}
                            <div class="type-image-effectiveness">
                                {{{loadTypeImages effectiveness.type}}}
                                <span class="ml-1">x{{effectiveness.value}}</span>
                            </div>
                            {{!-- {{/each}} --}}
                            {{/each}}
                        </div>
                        {{/if}}
                    </div>
                    {{/if}}
                </div>

                <div class="swsh-box w-100">
                    <div class="swsh-body w-100" style="display: block;">
                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs" title=(localize
                        "ITEM.TypeEdgePlural") type="edge" items=edges featsOrEdges=actor.system.edges}}
                    </div>
                </div>
            </div>

            <div class="pe-col pe-col-side">
                <div class="swsh-box mb-2">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 d-flex flex-row align-items-center pe-name-row">
                        <input class="pe-name" name="name" type="text" value="{{actor.name}}" placeholder="Name" />
                        <input class="pe-gender" data-link="system.sex" type="text" value="{{actor.system.sex}}"
                            placeholder="Genre" title="Genre" />
                    </div>
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 d-flex flex-row center-text justify-content-between">
                        <div class="fb-25">
                            <b>Temp HP</b>
                        </div>
                        <div class="fb-35">
                            <b>Current HP</b>
                        </div>
                        <div class="fb-25">
                            <b>Max HP</b>
                        </div>
                        <div class="fb-15" title="Fragment de Point de Vie : 1/20e des PV max">
                            <b>Frag</b>
                        </div>
                    </div>
                    <div class="swsh-body d-flex flex-row center-text justify-content-between">
                        <div class="fb-25">
                            <input name="system.tempHp.value" type="number" value="{{actor.system.tempHp.value}}" placeholder="Temp HP" />
                        </div>
                        <div class="fb-35">
                            <input name="system.health.value" type="number" value="{{actor.system.health.value}}" placeholder="Current HP" />
                        </div>
                        <div class="fb-25">
                            <input name="system.health.max" type="number" value="{{actor.system.health.max}}" placeholder="Max HP" disabled/>
                        </div>
                        <div class="fb-15 center-text" style="align-self:center;" title="Fragment de Point de Vie">
                            <b>{{epopee.hpFragment}}</b>
                        </div>
                        <div class="options w-100 pb-1 pt-1 mt-1">
                            <div class="progress-bar p{{actor.system.health.percent}}" id="progressBar"></div>
                        </div>
                    </div>
                </div>

                <div class="pe-portrait">
                    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
                </div>

                <div class="pe-pair">
                    <div class="swsh-box" style="text-align: center;">
                        <div class="swsh-header ball-themes {{ballStyle}} highlight p-1 justify-content-center" title="Slots d'inventaire utilisés">
                            <b>Inventory Space</b>
                        </div>
                        <div class="swsh-body pe-inline align-items-center pt-1 pb-1"
                            style="{{#if epopee.slotsOver}}color:#c0392b;font-weight:bold;{{/if}}">
                            <span>{{epopee.slotsUsed}} /</span>
                            <input type="number" name="system.epopee.itemSlots" value="{{epopee.slotsMax}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="swsh-box" style="text-align: center;">
                        <div class="swsh-header ball-themes {{ballStyle}} highlight p-1 justify-content-center" title="Niveau maximum des Pokémon contrôlables">
                            <b>Contrôle max</b>
                        </div>
                        <div class="swsh-body pe-inline align-items-center pt-1 pb-1">
                            <b style="font-size: 16px;">{{epopee.maxControlLevel}}</b>
                            <input type="number" name="system.epopee.maxControlLevelOverride"
                                value="{{actor.system.epopee.maxControlLevelOverride}}" data-dtype="Number"
                                placeholder="auto" title="Laisser vide pour suivre le niveau du Dresseur" />
                        </div>
                    </div>
                </div>

                <div class="swsh-box">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-1 pb-1 center-text justify-content-center">
                        <b>Identité</b>
                    </div>
                    <div class="swsh-body pe-identity pt-1 pb-1">
                        <label for="system.sex">Genre</label>
                        <input type="text" name="system.sex" value="{{actor.system.sex}}" />
                        <label for="system.height">Taille</label>
                        <input type="text" name="system.height" value="{{actor.system.height}}" />
                        <label for="system.weight">Poids</label>
                        <input type="text" name="system.weight" value="{{actor.system.weight}}" />
                        <label for="system.age">Âge</label>
                        <input type="text" name="system.age" value="{{actor.system.age}}" data-dtype="String" />
                    </div>
                </div>

                <div class="swsh-box mb-2 w-100">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-1 pb-1 center-text justify-content-center">
                        <b>Origine</b>
                    </div>
                    <div class="swsh-body center-text pt-1 pb-1">
                        <button type="button" class="origin-wizard" style="width:100%;">
                            <i class="fas fa-scroll"></i>
                            {{#if epopee.origin.name}}{{epopee.origin.name}}{{#if epopee.origin.choice}} [{{epopee.origin.choice}}]{{/if}}
                            {{else}}Choisir une Origine{{/if}}
                        </button>
                        {{#if epopee.origin.description}}
                        {{!-- pre-line: the wizard writes a plain-text block with
                              real newlines, and this is rendered escaped. --}}
                        <div style="font-size:11px;opacity:.8;text-align:left;padding:4px;white-space:pre-line;">{{epopee.origin.description}}</div>
                        {{/if}}
                    </div>
                </div>
            </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="tab details actions pe-tab" data-group="primary" data-tab="actions">
            <div class="pe-layout">
            <div class="pe-col pe-col-main">
                <div class="pe-group" style="order: {{epopee.listOrder.moves}};">
                    <div class="swsh-box w-100 mb-2">
                        <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "PTU.Epopee.CommonCapabilities"}}</b>
                        </div>
                        <div class="swsh-body w-100" style="display: block;">
                            <div class="d-flex flex-row align-items-center w-100 p-1"
                                title="{{localize "PTU.Epopee.StruggleHint"}}">
                                <div class="fb-10 center-text"><i class="fas fa-hand-fist"></i></div>
                                <div class="fb-60"><b>{{localize "PTU.Epopee.Struggle"}}</b></div>
                                <div class="fb-30 center-text" style="font-size:11px;">{{localize "PTU.Epopee.Always"}}</div>
                            </div>
                            <div class="d-flex flex-row align-items-center w-100 p-1">
                                <div class="fb-10 center-text"><i class="fas fa-shield"></i></div>
                                <div class="fb-60"><b>{{localize "PTU.Epopee.ProtectionAction"}}</b></div>
                                <div class="fb-30 center-text" style="font-size:11px;">{{localize "PTU.Epopee.Always"}}</div>
                            </div>
                            <div class="d-flex flex-row align-items-center w-100 p-1">
