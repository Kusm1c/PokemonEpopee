<form class="{{cssClass}} container-fluid" autocomplete="off">

    <div class="ball-themes element background {{ballStyle}}"></div>
    <div class="ball-themes element gradient {{ballStyle}}"></div>
    <!-- Highlight Shape JS insert -->
    <div class="ball-themes element light-color {{ballStyle}}"></div>
    <div class="ball-themes element band {{ballStyle}}"></div>

    <header class="sheet-header sheet-tabs ball-themes background {{ballStyle}}" data-group="primary">
        <nav class="tabs" data-group="primary">
            {{!-- Epopee: four tabs, in the order the design calls for. Statistics keeps
                  the internal id `stats` because pokemon/sheet.js declares it as the
                  `initial` tab - renaming the id would open the sheet on nothing.
                  Mechanics holds the rarely-touched machinery. --}}
            <a class="item tooltip ball-themes {{ballStyle}}" title="{{localize "PTU.Epopee.TabStatistics"}}" data-tab="stats"><i class="fas fa-bars-progress"></i></a>
            <a class="item tooltip ball-themes {{ballStyle}}" title="{{localize "PTU.Epopee.TabActions"}}" data-tab="actions"><i class="fas fa-burst"></i></a>
            <a class="item tooltip ball-themes {{ballStyle}}" title="{{localize "PTU.Epopee.TabNarrative"}}" data-tab="narrative"><i class="fas fa-feather"></i></a>
            <a class="item tooltip ball-themes {{ballStyle}}" title="{{localize "PTU.Epopee.TabMechanics"}}" data-tab="extra"><i class="fas fa-gear"></i></a>
        </nav>
    </header>
    <main class="sheet-body h-100">
        <!-- Statistics -->
        <div class="tab details stats pe-tab" data-group="primary" data-tab="stats">
            <div class="pe-layout">
            <div class="pe-col pe-col-main">
                <div class="w-100 stats-box swsh-box mb-2">
                    <div class="d-flex flex-row swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2">
                        <div class="fb-20 pt-2 pb-2 key stat-header">{{localize "PTU.StatsLabel"}}</div>
                        <div class="fb-15 mt-2 mb-2">{{localize "PTU.StatsBase"}}</div>
                        <div class="fb-20 mt-2 mb-2">{{localize "PTU.StatsLevelup"}}</div>
                        <div class="fb-15 mt-2 mb-2">{{localize "PTU.StatsMod"}}</div>
                        <div class="fb-15 mt-2 mb-2">{{localize "PTU.StatsStage"}}</div>
                        <div class="fb-15 mt-2 mb-2">{{localize "PTU.StatsTotal"}}</div>
                        <div class="fb-10 mt-2 mb-2"
                            title="{{localize "PTU.Epopee.Fragment"}}">Frag</div>
                        <div class="fb-25 mt-2 mb-2" title="{{localize "PTU.Epopee.CombatStages"}}">MdS</div>
                    </div>
                    <div class="swsh-body p-0">
                        {{#each actor.system.stats as |stat key|}}
                        <div class="d-flex flex-row {{key}}">
                            <div class="stats {{key}} key fb-20 {{natureCheck ../actor.system.nature.value key}}">
                                <label for="system.stats.{{key}}.value" class="resource-label">{{key}}</label>
                            </div>
                            <div class="stats {{key}} base fb-15">
                                <input type="number" name="system.stats.{{key}}.value" value="{{stat.value}}"
                                    data-dtype="Number" disabled />
                            </div>
                            <div class="stats {{key}} levelUp fb-20">
                                {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                path=(concat "system.stats." key ".levelUp")
                                value=stat.levelUp
                                dtype="Number"
                                mod=""
                                total="ignored"
                                modOrigins=(getProperty ../actor.origins (concat "system.stats." key
                                ".levelUp"))
                                flipped=(gt 3 @index)}}
                            </div>
                            <div class="stats {{key}} mod fb-15">
                                {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                mod=stat.mod.mod
                                path=(concat "system.stats." key ".mod.value")
                                value=stat.mod.value
                                total="ignored"
                                dtype="Number"
                                modOrigins=(getProperty ../actor.origins (concat "system.stats." key
                                ".mod.mod"))
                                flipped=(gt 3 @index)}}
                            </div>
                            <div class="stats stage stage fb-15">
                                {{#if (isdefined stat.stage)}}
                                {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                mod=stat.stage.mod
                                path=(concat "system.stats." key ".stage.value")
                                value=stat.stage.value
                                total="ignored"
                                dtype="Number"
                                modOrigins=(getProperty ../actor.origins (concat "system.stats." key
                                ".stage.mod"))
                                flipped=(gt 3 @index)}}
                                {{/if}}
                            </div>
                            <div class="stats {{key}} total fb-15">
                                <input type="number" name="system.stats.{{key}}.total" value="{{stat.total}}"
                                    data-dtype="Number" disabled />
                            </div>
                            {{!-- Epopee: Fragment de {Stat} = 25% rounded up --}}
                            <div class="stats {{key}} fragment fb-10 center-text" title="Fragment de {{key}} (25%)">
                                {{#if (lookup ../epopee.fragments key)}}<b>{{lookup ../epopee.fragments key}}</b>
                                {{else}}<span style="opacity:.4;">-</span>{{/if}}
                            </div>
                            {{!-- Epopee: MdS gauges, 2 rows of 6 --}}
                            <div class="stats {{key}} mds fb-25">
                                {{#with (lookup ../epopee.gauges key) as |gauge|}}
                                <div class="d-flex flex-column" style="gap:1px;" title="MdS: {{gauge.current}} ({{gauge.dice}})">
                                    <div class="d-flex" style="gap:1px;">
                                        {{#each gauge.positive as |cell|}}
                                        <span class="mds-cell" data-stat="{{key}}" data-index="{{cell.index}}"
                                            style="width:10px;height:10px;border:1px solid #666;display:inline-block;cursor:pointer;background:{{#if cell.filled}}#4caf50{{else}}#fff{{/if}};"></span>
                                        {{/each}}
                                    </div>
                                    <div class="d-flex" style="gap:1px;">
                                        {{#each gauge.negative as |cell|}}
                                        <span class="mds-cell" data-stat="{{key}}" data-index="{{cell.index}}"
                                            style="width:10px;height:10px;border:1px solid #666;display:inline-block;cursor:pointer;background:{{#if cell.filled}}#e05555{{else}}#fff{{/if}};"></span>
                                        {{/each}}
                                    </div>
                                </div>
                                {{/with}}
                            </div>
                        </div>
                        {{/each}}

                        {{!-- Epopee: PRE and ESQ sit below the six main stats and
                              deliberately have no Level-Up column - they are not
                              bought with stat points. They live under
                              system.secondaryStats rather than system.stats so the
                              loop above cannot pick them up and give them one. --}}
                        {{#each actor.system.secondaryStats as |stat key|}}
                        <div class="d-flex flex-row {{key}}">
                            <div class="stats {{key}} key fb-20">
                                <label for="system.secondaryStats.{{key}}.value" class="resource-label"
                                    title="{{localize stat.labelKey}}">{{localize stat.abbrKey}}</label>
                            </div>
                            <div class="stats {{key}} base fb-15">
                                <input type="number" name="system.secondaryStats.{{key}}.value"
                                    value="{{stat.value}}" data-dtype="Number" />
                            </div>
                            {{!-- Empty cell where Level-Up would be. --}}
                            <div class="fb-20 center-text" style="opacity:.3;">&mdash;</div>
                            <div class="stats {{key}} mod fb-15">
                                {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                mod=stat.mod.mod
                                path=(concat "system.secondaryStats." key ".mod.value")
                                value=stat.mod.value
                                total="ignored"
                                dtype="Number"
                                modOrigins=(getProperty ../actor.origins (concat "system.secondaryStats." key
                                ".mod.mod"))}}
                            </div>
                            <div class="stats stage stage fb-15">
                                {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                mod=stat.stage.mod
                                path=(concat "system.secondaryStats." key ".stage.value")
                                value=stat.stage.value
                                total="ignored"
                                dtype="Number"
                                modOrigins=(getProperty ../actor.origins (concat "system.secondaryStats." key
                                ".stage.mod"))}}
                            </div>
                            <div class="stats {{key}} total fb-15">
                                <input type="number" name="system.secondaryStats.{{key}}.total"
                                    value="{{stat.total}}" data-dtype="Number" disabled />
                            </div>
                            {{!-- No Fragment: PRE/ESQ are accuracy modifiers, not
                                  values a Fragment is ever taken of. --}}
                            <div class="fb-10 center-text"><span style="opacity:.3;">&mdash;</span></div>
                            <div class="fb-25"></div>
                        </div>
                        {{/each}}
                    </div>
                    {{#if actor.system.levelUpPoints}}
                    <div class="d-flex flex-row levelUpPoints center-text align-items-center">
                        <div class="fb-70">
                            <label for="system.levelUpPoints" class="resource-label">{{localize
                                "PTU.StatsRemainingLevelupPoints"}}:</label>
                        </div>
                        <div class="fb-30">
                            {{> "systems/pe/static/templates/partials/mod-field.hbs"
                            path="system.levelUpPoints"
                            value=actor.system.levelUpPoints
                            dtype="Number"
                            mod=""
                            total=actor.system.levelUpPoints
                            modOrigins=(getProperty actor.origins "system.levelUpPoints")
                            disabled=true}}
                        </div>
                    </div>
                    {{/if}}
                </div>

                <div class="swsh-box">
                    <div class="swsh-body pt-3 p-2">
                        {{!-- Epopee: 3 statuses max. Soft like the move limits - the
                              banner warns, nothing is blocked, since a status is
                              inflicted rather than chosen. Only the eight real
                              statuses count; Traps and Coats are listed below with
                              the other conditions but do not fill a slot. --}}
                        {{#if epopee.statuses.over}}
                        <div class="center-text" style="background:#c0392b;color:#fff;padding:2px;font-size:11px;">
                            {{localize "PTU.Epopee.StatusesOver" count=epopee.statuses.count max=epopee.statuses.max}}
                        </div>
                        {{/if}}
                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs" title=(concat
                        (localize "TYPES.Item.conditionPlural") " (" epopee.statuses.count "/" epopee.statuses.max ")")
                        type="condition" items=conditions}}
                    </div>
                    <div class="swsh-body pt-3 p-2">
                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs" title=(localize
                        "TYPES.Item.effectPlural") type="effect" items=effects}}
                    </div>
                </div>

                <div class="combat">
                    <div class="swsh-box effectiveness mb-2 w-100">
                        <div
                            class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "PTU.Typing"}}</b>
                        </div>
                        <div
                            class="swsh-body mt-1 mb-1 flexrow g-1 p-0 w-100 align-items-center justify-content-center">
                            {{{loadTypeImages actor.system.typing}}}
                        </div>
                        {{#if (gt effectiveness.weaknesses.length 0) }}
                        <div
                            class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "PTU.TypingWeaknesses"}}</b>
                        </div>
                        <div
                            class="swsh-body mt-1 mb-1 flexrow g-5 w-100 align-items-center justify-content-between">
                            {{#each effectiveness.weaknesses as |effectiveness|}}
                            {{!-- {{#each effectiveness as |value type|}} --}}
                            <div class="type-image-effectiveness">
                                {{{loadTypeImages effectiveness.type}}}
                                <span class="ml-1">x{{effectiveness.value}}</span>
                            </div>
                            {{!-- {{/each}} --}}
                            {{/each}}
                        </div>
                        {{/if}}
                        <!-- Hide regular effective moves -->
                        {{!-- {{#if (gt actor.system.effectiveness.Normal.length 0) }}
                        <div
                            class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "PTU.TypingNormal"}}</b>
                        </div>
                        <div class="swsh-body flexrow g-5 w-100 align-items-center">
                            {{#each actor.system.effectiveness.Normal as |effectiveness|}}
                            {{#each effectiveness as |value type|}}
                            <div class="type-image-effectiveness">
                                {{{loadTypeImages type}}}
                                <span class="ml-1">x{{value}}</span>
                            </div>
                            {{/each}}
                            {{/each}}
                        </div>
                        {{/if}} --}}
                        {{#if (gt effectiveness.resistances.length 0) }}
                        <div
                            class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "PTU.TypingResistances"}}</b>
                        </div>
                        <div
                            class="swsh-body mt-1 mb-1 flexrow g-5 w-100 align-items-center justify-content-between">
                            {{#each effectiveness.resistances as |effectiveness|}}
                            {{!-- {{#each effectiveness as |value type|}} --}}
                            <div class="type-image-effectiveness">
                                {{{loadTypeImages effectiveness.type}}}
                                <span class="ml-1">x{{effectiveness.value}}</span>
                            </div>
                            {{!-- {{/each}} --}}
                            {{/each}}
                        </div>
                        {{/if}}
                        {{#if (gt effectiveness.immunities.length 0) }}
                        <div
                            class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "PTU.TypingImmunities"}}</b>
                        </div>
                        <div
                            class="swsh-body mt-1 mb-1 flexrow g-5 w-100 align-items-center justify-content-between">
                            {{#each effectiveness.immunities as |effectiveness|}}
                            {{!-- {{#each effectiveness as |value type|}} --}}
                            <div class="type-image-effectiveness">
                                {{{loadTypeImages effectiveness.type}}}
                                <span class="ml-1">x{{effectiveness.value}}</span>
                            </div>
                            {{!-- {{/each}} --}}
                            {{/each}}
                        </div>
                        {{/if}}
                    </div>
                </div>

                <div class="swsh-box w-100">
                    <div class="swsh-body w-100" style="display: block;">
                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs" title=(localize
                        "ITEM.TypePokeedgePlural") type="pokeedge" items=edges}}
                    </div>
                </div>
            </div>

            <div class="pe-col pe-col-side">
                <div class="swsh-box mb-2">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 d-flex flex-row align-items-center pe-name-row">
                        <input class="pe-name" name="name" type="text" value="{{actor.name}}" placeholder="Name" />
                        <input class="pe-gender" name="system.gender" type="text" value="{{actor.system.gender}}"
                            placeholder="{{localize "PTU.Gender"}}" title="{{localize "PTU.Gender"}}" data-dtype="String" />
                    </div>
                    <div
                        class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 d-flex flex-row center-text justify-content-between">
                        <div class="fb-25">
                            <b>Temp HP</b>
                        </div>
                        <div class="fb-35">
                            <b>Current HP</b>
                        </div>
                        <div class="fb-25">
                            <b>Max HP</b>
                        </div>
                        <div class="fb-15" title="Fragment de Point de Vie: 1/20th of max HP, rounded up">
                            <b>Frag</b>
                        </div>
                    </div>
                    <div class="swsh-body d-flex flex-row center-text justify-content-between">
                        <div class="fb-25">
                            <input name="system.tempHp.value" type="number"
                                value="{{actor.system.tempHp.value}}" placeholder="Temp HP" />
                        </div>
                        <div class="fb-35">
                            <input name="system.health.value" type="number"
                                value="{{actor.system.health.value}}" placeholder="Current HP" />
                        </div>
                        <div class="fb-25">
                            <input name="system.health.max" type="number" value="{{actor.system.health.max}}"
                                placeholder="Max HP" disabled />
                        </div>
                        {{!-- Epopee: the HP Fragment is 1/20th of max HP, i.e. 5%,
                              not the 25% the other stats use. It sits by the HP
                              bar because HP has no row in the stat table, so the
                              label has to carry the percentage itself - a bare
                              number here reads as a 25% Fragment like the rest. --}}
                        <div class="fb-15 center-text" style="align-self:center;"
                            title="{{localize "PTU.Epopee.HpFragmentHint" max=actor.system.health.max}}">
                            <div style="font-size:9px;opacity:.7;line-height:1;">{{localize "PTU.Epopee.HpFragment"}}</div>
                            <b>{{epopee.hpFragment}}</b>
                        </div>
                        <div class="options w-100 pb-1 pt-1 mt-1">
                            <div class="progress-bar p{{actor.system.health.percent}}" id="progressBar"></div>
                        </div>
                    </div>
                </div>

                <div class="pe-portrait">
                    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
                </div>

                <div class="swsh-box level-box" style="text-align: center;">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight p-1 justify-content-center align-items-center" style="gap: 8px;">
                        <label for="system.level.current">{{localize "PTU.Level"}}:</label>
                        <input class="p-0 pe-level" type="text" name="system.level.current"
                            value="{{actor.system.level.current}}" data-dtype="Number" disabled />
                    </div>
                    <div class="swsh-header ball-themes {{ballStyle}} highlight">
                        <div class="d-flex w-100 mt-2 mb-2 align-items-center justify-content-between">
                            <div class="fb-45">
                                <label for="system.level.exp"><b>{{localize "PTU.Experience"}}</b></label>
                            </div>
                            <div class="fb-45">
                                <label for="till-level-up"><b>{{localize "PTU.ExperienceNext"}}</b></label>
                            </div>
                        </div>
                    </div>
                    <div class="swsh-body">
                        <div class="d-flex flexrow pt-1 pb-1 align-items-center justify-content-between center-text w-100">
                            <div class="fb-45">
                                <input type="text" name="system.level.exp" value="{{actor.system.level.exp}}" data-dtype="Number" />
                            </div>
                            <div class="fb-10">
                                <span style="font-size: 20px;"> / </span>
                            </div>
                            <div class="fb-45">
                                <input type="text" name="till-level-up" value="{{actor.system.level.expTillNextLevel}}"
                                    data-dtype="Number" disabled />
                            </div>
                            <div class="options fb-100 pb-1 pt-1 mt-1">
                                <div class="progress-bar p{{actor.system.level.percent}}" id="progressBar"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pe-pair">
                    <div class="swsh-box" style="text-align: center;">
                        <div class="swsh-header ball-themes {{ballStyle}} highlight p-1 justify-content-center" title="STAB = 5 + (Level / 5)">
                            <b>STAB</b>
                        </div>
                        <div class="swsh-body justify-content-center align-items-center pt-1 pb-1">
                            <b style="font-size: 16px;">{{epopee.stab}}</b>
                        </div>
                    </div>
                    <div class="swsh-box" style="text-align: center;">
                        <div class="swsh-header ball-themes {{ballStyle}} highlight p-1 justify-content-center" title="Difficulte d'Entrainement">
                            <b>Training DC</b>
                        </div>
                        <div class="swsh-body align-items-center pt-1 pb-1 pe-training">
                            <input type="number" name="system.trainingDifficulty" value="{{epopee.trainingDifficulty}}" data-dtype="Number" />
                            <button type="button" class="training-roll" title="Roll 1d100 against the Training Difficulty">
                                <i class="fas fa-dumbbell"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="w-100 loyalty-box mt-2 mb-1">
                    <div class="swsh-box" style="text-align: center;">
                        {{!-- Epopee: the cell row alone made you count squares to read
                              the value, so the number is shown alongside it. --}}
                        <div class="swsh-header ball-themes {{ballStyle}} highlight p-1 center-text">
                            <b>Loyalty</b>
                            <span style="margin-left:6px;opacity:.9;"
                                title="{{localize "PTU.Epopee.LoyaltyProgress" current=actor.system.loyalty.checked required=actor.system.loyalty.unlocked}}">
                                {{actor.system.loyalty.checked}} / {{actor.system.loyalty.unlocked}}
                            </span>
                        </div>
                        <div class="swsh-body d-flex flex-wrap justify-content-center pt-1 pb-1" style="gap: 2px;">
                            {{#each (range 0 20) as |i|}}
                            <span class="loyalty-cell {{#if (bigger ../actor.system.loyalty.checked i)}}checked{{else if (bigger ../actor.system.loyalty.unlocked i)}}empty{{else}}locked{{/if}}"
                                data-index="{{i}}"
                                style="width: 14px; height: 14px; border: 1px solid #666; display: inline-block; cursor: pointer; background: {{#if (bigger ../actor.system.loyalty.checked i)}}#e8b923{{else if (bigger ../actor.system.loyalty.unlocked i)}}#ffffff{{else}}#555555{{/if}};"
                                title="Loyalty {{inc i}}"></span>
                            {{/each}}
                        </div>
                    </div>
                </div>

                <div class="swsh-box">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                        <label for="system.species"><b>{{localize "PTU.Species"}}</b></label>
                    </div>
                    <div class="swsh-body mt-1 mb-1 justify-content-center">
                        {{#if actor.species}}
                        <span class="species linked-item">@UUID[{{actor.species.uuid}}]</span>
                        {{else}}
                        <input type="text" name="system.species" value="{{actor.system.species}}" data-dtype="String" disabled />
                        {{/if}}
                    </div>
                </div>

                <div class="swsh-box" style="text-align: center;">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                        <label for="system.nature.value"><b>{{localize "PTU.Nature"}}</b></label>
                    </div>
                    <div class="swsh-body pt-1 pb-1">
                        {{!-- natureChoices annotates each Nature with the stats it moves. The old form
                              fed the raw table through labelAttr="value", which printed the
                              [raised, lowered] array as the option text. --}}
                        <select name="system.nature.value" class="w-100">
                            {{selectOptions natureChoices selected=actor.system.nature.value valueAttr="value" labelAttr="label"}}
                        </select>
                    </div>
                </div>
            </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="tab details actions pe-tab" data-group="primary" data-tab="actions">
            <div class="pe-layout">
            <div class="pe-col pe-col-main">
                <div class="pe-group" style="order: {{#if epopee.skillsFirst}}2{{else}}1{{/if}};">
                    <div class="swsh-box mb-2 w-100">
                        <div
                            class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "PTU.Epopee.CommonCapabilities"}}</b>
                        </div>
                        <div class="swsh-body w-100" style="display: block;">
                            <div class="d-flex flex-row align-items-center w-100 p-1"
                                title="{{localize "PTU.Epopee.StruggleHint"}}">
                                <div class="fb-10 center-text"><i class="fas fa-hand-fist"></i></div>
                                <div class="fb-60"><b>{{localize "PTU.Epopee.Struggle"}}</b></div>
                                <div class="fb-30 center-text" style="font-size:11px;">{{localize "PTU.Epopee.Always"}}</div>
                            </div>
                            <div class="d-flex flex-row align-items-center w-100 p-1"
                                style="{{#unless epopee.reactionUnlocked}}opacity:.45;{{/unless}}"
                                title="{{#if epopee.reactionUnlocked}}{{localize "PTU.Epopee.Unlocked"}}{{else}}{{localize "PTU.Epopee.LockedLoyalty" required=epopee.loyaltyReaction current=epopee.loyaltyChecked}}{{/if}}">
                                <div class="fb-10 center-text">
                                    <i class="fas {{#if epopee.reactionUnlocked}}fa-shield-halved{{else}}fa-lock{{/if}}"></i>
                                </div>
                                <div class="fb-60"><b>{{localize "PTU.Epopee.ReactionAction"}}</b></div>
                                <div class="fb-30 center-text" style="font-size:11px;">
                                    {{#if epopee.reactionUnlocked}}{{localize "PTU.Epopee.LoyaltyMet" required=epopee.loyaltyReaction}}{{else}}{{localize "PTU.Epopee.LoyaltyProgress" current=epopee.loyaltyChecked required=epopee.loyaltyReaction}}{{/if}}
                                </div>
                            </div>
                            <div class="d-flex flex-row align-items-center w-100 p-1"
                                style="{{#unless epopee.protectionUnlocked}}opacity:.45;{{/unless}}"
                                title="{{#if epopee.protectionUnlocked}}{{localize "PTU.Epopee.Unlocked"}}{{else}}{{localize "PTU.Epopee.LockedLoyalty" required=epopee.loyaltyProtection current=epopee.loyaltyChecked}}{{/if}}">
                                <div class="fb-10 center-text">
                                    <i class="fas {{#if epopee.protectionUnlocked}}fa-shield{{else}}fa-lock{{/if}}"></i>
                                </div>
                                <div class="fb-60"><b>{{localize "PTU.Epopee.ProtectionAction"}}</b></div>
                                <div class="fb-30 center-text" style="font-size:11px;">
                                    {{#if epopee.protectionUnlocked}}{{localize "PTU.Epopee.LoyaltyMet" required=epopee.loyaltyProtection}}{{else}}{{localize "PTU.Epopee.LoyaltyProgress" current=epopee.loyaltyChecked required=epopee.loyaltyProtection}}{{/if}}
                                </div>
                            </div>
                        </div>
                    </div>

                    {{#if epopee.contestMode}}
                    <!-- Epopee: Contest Mode view - Nom / Type de Concours / Attrait / Tags -->
                    <div class="swsh-box w-100">
                        <div class="swsh-header ball-themes {{ballStyle}} highlight d-flex flex-row center-text" style="padding:unset;">
                            <div class="fb-35 mt-2 mb-2"><b>Nom</b></div>
                            <div class="fb-20 mt-2 mb-2"><b>Type de Concours</b></div>
                            <div class="fb-15 mt-2 mb-2"><b>Attrait</b></div>
                            <div class="fb-30 mt-2 mb-2"><b>Tags de Concours</b></div>
                        </div>
                        <div class="swsh-body p-0">
                            {{#each actions.moves as |move|}}
                            <div class="d-flex flex-row align-items-center w-100 center-text" style="padding:2px 0;">
                                <div class="fb-35">{{move.name}}</div>
                                <div class="fb-20">{{#if move.system.contestType}}{{move.system.contestType}}{{else}}<span style="opacity:.4;">-</span>{{/if}}</div>
                                <div class="fb-15">{{move.system.contestAppeal}}</div>
                                <div class="fb-30" style="font-size:11px;">
                                    {{#if move.system.contestTags.length}}{{#each move.system.contestTags}}{{this}} {{/each}}
                                    {{else}}<span style="opacity:.4;">-</span>{{/if}}
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{else}}
                    {{!-- Epopee: data-acquisition marks the drop zone. Both lists render
                          through the same partial with type="move", so without it a
                          dropped move has nothing to say which one it landed in and
                          always takes the "natural" default from template.json. --}}
                    <!-- Epopee: Capacites Naturelles (level-up / egg), 4 max -->
                    <div class="swsh-box w-100" data-acquisition="natural">
                        <div class="swsh-body w-100" style="display: block;">
                            {{#if actions.naturalOver}}
                            <div class="center-text" style="background:#c0392b;color:#fff;padding:2px;font-size:11px;">
                                {{actions.natural.length}} / {{actions.maxPerKind}} Capacités Naturelles &mdash; au-dessus de la limite
                            </div>
                            {{/if}}
                            {{> "systems/pe/static/templates/partials/item-display-partial.hbs"
                            title=(concat "Capacités Naturelles (" actions.natural.length "/" actions.maxPerKind ")")
                            type="move" items=actions.natural ballStyle=ballStyle}}
                        </div>
                    </div>

                    <!-- Epopee: Capacites Techniques (TM / tutor), 4 max -->
                    <div class="swsh-box w-100 mt-2" data-acquisition="technical">
                        <div class="swsh-body w-100" style="display: block;">
                            {{#if actions.technicalOver}}
                            <div class="center-text" style="background:#c0392b;color:#fff;padding:2px;font-size:11px;">
                                {{actions.technical.length}} / {{actions.maxPerKind}} Capacités Techniques &mdash; au-dessus de la limite
                            </div>
                            {{/if}}
                            {{> "systems/pe/static/templates/partials/item-display-partial.hbs"
                            title=(concat "Capacités Techniques (" actions.technical.length "/" actions.maxPerKind ")")
                            type="move" items=actions.technical ballStyle=ballStyle}}
                        </div>
                    </div>
                    {{/if}}

                    {{#if actions.struggles.length}}
                    <div class="swsh-box w-100 mt-2">
                        <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                            <b>{{localize "ITEM.TypeStrugglePlural"}}</b>
                        </div>
                        <div class="swsh-body w-100" style="display: block;">
                            {{> "systems/pe/static/templates/partials/item-display-partial.hbs" title=(localize
                            "ITEM.TypeStrugglePlural") type="move" items=actions.struggles ballStyle=ballStyle
                            no-add=true}}
                        </div>
                    </div>
                    {{/if}}
                </div>

                <div class="pe-group capability" style="order: {{#if epopee.skillsFirst}}1{{else}}2{{/if}};">
                    <div class="skills">
                        <div class="swsh-box w-100 mb-2" style="height: fit-content;">
                            <div class="swsh-header d-flex flex-row center-text ball-themes {{ballStyle}} highlight"
                                style="padding:unset;">
                                <div class="fb-30 mt-2 mb-2"><b>{{localize "PTU.SkillLabel"}}</b></div>
                                <div class="fb-15 mt-2 mb-2"><b>{{localize "PTU.SkillValue"}}</b></div>
                                <div class="fb-20 mt-2 mb-2"><b>{{localize "PTU.SkillRank"}}</b></div>
                                <div class="fb-15 mt-2 mb-2"><b>{{localize "PTU.SkillMod"}}</b></div>
                                <div class="fb-20 mt-2 mb-2"><b>{{localize "PTU.SkillDice"}}</b></div>
                            </div>
                            <div class="swsh-body p-0">
                                {{#each epopee.skillGroups as |group|}}
                                <div class="d-flex flex-row align-items-center w-100 center-text"
                                    style="background:{{group.colour}};color:#fff;font-weight:bold;letter-spacing:1px;padding:2px 0;font-size:11px;">
                                    <div class="w-100">{{localize group.labelKey}}</div>
                                </div>
                                {{#each group.skills as |s|}}
                                <div class="d-flex flex-row {{s.key}} align-items-center w-100">
                                    <div class="skill {{s.key}} fb-30 bgcolor key type--{{s.type}} align-self-center">
                                        <label class="resource-label">{{localize s.labelKey}}</label>
                                    </div>
                                    <div class="skill {{s.key}} fb-15 pl-1 pr-1 center-text center-self">
                                        {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                        path=s.valuePath
                                        value=s.value
                                        dtype="Number"
                                        mod=s.valueMod
                                        total=s.valueTotal
                                        modOrigins=s.valueOrigins
                                        disabled=true}}
                                    </div>
                                    <div class="skill {{s.key}} fb-20 align-self-center bgcolor skill--{{s.rank}} center-text center-self">
                                        <label class="resource-label">{{localize s.rankLabelKey}}</label>
                                    </div>
                                    <div class="skill {{s.key}} fb-15 pl-1 center-text center-self">
                                        {{> "systems/pe/static/templates/partials/mod-field.hbs"
                                        path=s.modifierPath
                                        value=s.modifierValue
                                        dtype="Number"
                                        mod=s.modifierMod
                                        total=s.modifierTotal
                                        modOrigins=s.modifierOrigins
                                        disabled=true}}
                                    </div>
                                    <div class="skill {{s.key}} fb-20 align-self-center bgcolor center-text rollable center-self"
                                        data-roll="{{s.rollFormula}}"
                                        data-skill="{{s.key}}">
                                        <i class="fas fa-dice-d20"></i>
                                        <label class="resource-label">{{s.rollFormula}}</label>
                                    </div>
                                </div>
                                {{/each}}
                                {{/each}}

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pe-col pe-col-side">
                <div class="swsh-box mb-2">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 d-flex flex-row align-items-center pe-name-row">
                        <input class="pe-name" data-link="name" type="text" value="{{actor.name}}" placeholder="Name" />
                        <input class="pe-gender" data-link="system.gender" type="text" value="{{actor.system.gender}}"
                            placeholder="{{localize "PTU.Gender"}}" title="{{localize "PTU.Gender"}}" data-dtype="String" />
                    </div>
                    <div
                        class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 d-flex flex-row center-text justify-content-between">
                        <div class="fb-25">
                            <b>Temp HP</b>
                        </div>
                        <div class="fb-35">
                            <b>Current HP</b>
                        </div>
                        <div class="fb-25">
                            <b>Max HP</b>
                        </div>
                        <div class="fb-15" title="Fragment de Point de Vie: 1/20th of max HP, rounded up">
                            <b>Frag</b>
                        </div>
                    </div>
                    <div class="swsh-body d-flex flex-row center-text justify-content-between">
                        <div class="fb-25">
                            <input data-link="system.tempHp.value" type="number"
                                value="{{actor.system.tempHp.value}}" placeholder="Temp HP" />
                        </div>
                        <div class="fb-35">
                            <input data-link="system.health.value" type="number"
                                value="{{actor.system.health.value}}" placeholder="Current HP" />
                        </div>
                        <div class="fb-25">
                            <input data-link="system.health.max" type="number" value="{{actor.system.health.max}}"
                                placeholder="Max HP" disabled />
                        </div>
                        {{!-- Epopee: the HP Fragment is 1/20th of max HP, i.e. 5%,
                              not the 25% the other stats use. It sits by the HP
                              bar because HP has no row in the stat table, so the
                              label has to carry the percentage itself - a bare
                              number here reads as a 25% Fragment like the rest. --}}
                        <div class="fb-15 center-text" style="align-self:center;"
                            title="{{localize "PTU.Epopee.HpFragmentHint" max=actor.system.health.max}}">
                            <div style="font-size:9px;opacity:.7;line-height:1;">{{localize "PTU.Epopee.HpFragment"}}</div>
                            <b>{{epopee.hpFragment}}</b>
                        </div>
                        <div class="options w-100 pb-1 pt-1 mt-1">
                            <div class="progress-bar p{{actor.system.health.percent}}" id="progressBar"></div>
                        </div>
                    </div>
                </div>

                <div class="pe-pair">
                    <button type="button" class="pe-big-button list-order-toggle"
                        title="Inverse l'ordre des listes de Capacités et de Compétences">
                        <i class="fas fa-sort"></i>
                        <span>Capacités / Objets / Compétences</span>
                    </button>
                    <button type="button" class="pe-big-button contest-mode-toggle"
                        title="Bascule la liste des Capacités en Mode Concours">
                        <i class="fas fa-award"></i>
                        <span>{{#if epopee.contestMode}}Quitter le Mode Concours{{else}}Mode Concours{{/if}}</span>
                    </button>
                </div>

                <div class="swsh-box mb-2 w-100">
                    <div
                        class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                        <b>{{localize "PTU.HeldItems"}}</b>
                    </div>
                    <div class="swsh-body w-100" style="display: block;">
                        {{#if epopee.heldItems.heldOver}}
                        <div class="center-text" style="background:#c0392b;color:#fff;padding:2px;font-size:11px;">
                            {{epopee.heldItems.held.length}} Objets Tenus &mdash; 1 maximum
                        </div>
                        {{/if}}
                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs"
                        title="Objet Tenu" type="item" items=epopee.heldItems.held ballStyle=ballStyle}}

                        {{#if epopee.heldItems.foundOver}}
                        <div class="center-text" style="background:#c0392b;color:#fff;padding:2px;font-size:11px;">
                            {{epopee.heldItems.found.length}} Objets Trouvés &mdash; 1 maximum
                        </div>
                        {{/if}}
                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs"
                        title="Objet Trouvé (part au dresseur en fin de scène)" type="item"
                        items=epopee.heldItems.found ballStyle=ballStyle}}

                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs"
                        title="Porté (aucun effet)" type="item" items=epopee.heldItems.carried ballStyle=ballStyle}}
                    </div>
                </div>

                <div class="swsh-box abilities mt-auto mb-1">
                    <div class="swsh-body w-100" style="display: block;">
                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs" title=(localize
                        "ITEM.TypeAbilityPlural") type="ability" items=abilities}}
                    </div>
                </div>

                <div class="swsh-box mb-2 w-100">
                    <div
                        class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                        <b>{{localize "ITEM.TypeCapabilityPlural"}}</b>
                    </div>
                    <div class="swsh-body flex-row w-100 align-items-center" style="white-space: nowrap;">
                        {{#each actor.system.capabilities as |capability key|}}
                                                        {{#if (and (notEqual key "Other") (notEqual key "other"))}}
                        {{#unless (or (is key "Naturewalk") (is key "naturewalk"))}}
                        {{#unless (is capability 0)}}
                        <div class="fb-35">
                            <label class="pl-1" for="system.capabilities.{{key}}">{{localize key}}</label>
                        </div>
                        <div class="fb-15 p-1 center-text">
                            <input type="number" name="system.capabilities.{{key}}" value="{{capability}}"
                                disabled />
                        </div>
                        {{/unless}}
                        {{/unless}}
                        {{/if}}
                        {{/each}}
                        <div class="fb-35">
                            <label class="pl-1" for="system.size.weightClass">{{localize "weightClass"}}</label>
                        </div>
                        <div class="fb-15 p-1 center-text">
                            <input type="number" name="system.size.weightClass"
                                value="{{actor.species.system.size.weightClass}}" disabled />
                        </div>
                        <div class="fb-100 d-flex flex-row align-items-center">
                            <div class="fb-35">
                                <label class="pl-1" for="system.capabilities.naturewalk">{{localize
                                    "naturewalk"}}</label>
                            </div>
                            <div class="fb-65 p-1">
                                <input type="text" name="system.capabilities.naturewalk"
                                    value="{{actor.system.capabilities.naturewalk}}" disabled />
                            </div>
                        </div>
                    </div>
                    <!-- Other Capabilities -->
                    <div class="swsh-body w-100 mt-2" style="display: block;">
                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs" title=(localize
                        "PTU.CapabilityOther") type="capability" items=capabilities}}
                    </div>
                </div>

                <div class="swsh-box">
                    <div class="swsh-body pt-3 p-2">
                        {{!-- Epopee: 3 statuses max. Soft like the move limits - the
                              banner warns, nothing is blocked, since a status is
                              inflicted rather than chosen. Only the eight real
                              statuses count; Traps and Coats are listed below with
                              the other conditions but do not fill a slot. --}}
                        {{#if epopee.statuses.over}}
                        <div class="center-text" style="background:#c0392b;color:#fff;padding:2px;font-size:11px;">
                            {{localize "PTU.Epopee.StatusesOver" count=epopee.statuses.count max=epopee.statuses.max}}
                        </div>
                        {{/if}}
                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs" title=(concat
                        (localize "TYPES.Item.conditionPlural") " (" epopee.statuses.count "/" epopee.statuses.max ")")
                        type="condition" items=conditions}}
                    </div>
                    <div class="swsh-body pt-3 p-2">
                        {{> "systems/pe/static/templates/partials/item-display-partial.hbs" title=(localize
                        "TYPES.Item.effectPlural") type="effect" items=effects}}
                    </div>
                </div>
            </div>
            </div>
        </div>

        <!-- Narrative -->
        <div class="tab details narrative pe-tab" data-group="primary" data-tab="narrative">
            <div class="pe-layout pe-halves">
            <div class="pe-col pe-col-main">
                <div class="swsh-box mb-2 w-100">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-between">
                        <b>Moments of Brilliance</b>
                        <a class="moment-create" title="Add Moment"><i class="fas fa-plus-circle"></i></a>
                    </div>
                    <div class="swsh-body" style="display: block;">
                        {{#each actor.system.narrative.momentsOfBrilliance as |moment index|}}
                        <div class="d-flex flex-row w-100 mb-1" style="gap: 4px;">
                            <textarea class="moment-text w-100" data-index="{{index}}" rows="2">{{moment}}</textarea>
                            <a class="moment-delete" data-index="{{index}}" title="Delete Moment"><i class="fas fa-trash"></i></a>
                        </div>
                        {{/each}}
                    </div>
                </div>

                <div class="swsh-box mb-2 w-100">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                        <b>Goûts</b>
                    </div>
                    <div class="swsh-body center-text pt-1 pb-1">
                        {{#if epopee.flavours.neutral}}
                        <span style="opacity:.6;">Aucune préférence (nature neutre)</span>
                        {{else}}
                        <div class="d-flex justify-content-between w-100">
                            <div class="fb-45">
                                <b>Préféré</b><br />
                                {{#if epopee.flavours.likedLabel}}{{epopee.flavours.likedLabel}}
                                {{else}}<span style="opacity:.5;">-</span>{{/if}}
                            </div>
                            <div class="fb-45">
                                <b>Détesté</b><br />
                                {{#if epopee.flavours.dislikedLabel}}{{epopee.flavours.dislikedLabel}}
                                {{else}}<span style="opacity:.5;">-</span>{{/if}}
                            </div>
                        </div>
                        {{/if}}
                    </div>
                </div>

                <div class="swsh-box">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-evenly">
                        <div class="fb-33">
                            <label for="system.egggroup"><b>{{localize "PTU.EggGroup"}}</b></label>
                        </div>
                        <div class="fb-33">
                            <label for="system.shiny"><b>{{localize "PTU.Shiny"}}</b></label>
                        </div>
                        <div class="fb-33">
                            <label><b>{{localize "PTU.Gender"}}</b></label>
                        </div>
                    </div>
                    <div class="swsh-body mt-1 mb-1 justify-content-evenly align-items-center">
                        <div class="fb-33 center-text pl-2 pr-2">
                            <input type="text" name="system.egggroup" value="{{actor.system.egggroup}}" data-dtype="String" disabled />
                        </div>
                        <div class="fb-33 center-text pl-2 pr-2">
                            <input name="system.shiny" type="checkbox" {{checked actor.system.shiny}} />
                        </div>
                        <div class="fb-33 center-text pl-2 pr-2">
                            <input type="text" data-link="system.gender" value="{{actor.system.gender}}" data-dtype="String" />
                        </div>
                    </div>
                </div>

                <div class="swsh-box">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                        <label for="system.pokeball"><b>{{localize "PTU.Pokeball"}}</b></label>
                    </div>
                    <div class="swsh-body justify-content-center pt-1 pb-1">
                        <input type="text" name="system.pokeball" value="{{actor.system.pokeball}}" data-dtype="String" />
                    </div>
                </div>

                <div class="swsh-box mb-2 w-100">
                    <div
                        class="swsh-header ball-themes {{ballStyle}} highlight pt-2 center-text justify-content-center">
                        <b>{{localize "PTU.SkillBackground"}}</b>
                    </div>
                    <div
                        class="swsh-header ball-themes {{ballStyle}} highlight pb-2 center-text justify-content-between">
                        <div class="fb-33">
                            <label for="system.background.increased.one"><b>{{localize "PTU.SkillUp"}} 1</b></label>
                        </div>
                        <div class="fb-33">
                            <label for="system.background.increased.two"><b>{{localize "PTU.SkillUp"}} 2</b></label>
                        </div>
                        <div class="fb-33">
                            <label for="system.background.increased.three"><b>{{localize "PTU.SkillUp"}}
                                    3</b></label>
                        </div>
                    </div>
                    <div class="swsh-body mt-1 mb-1">
                        <div class="fb-33 center-text">
                            <select name="system.background.increased.one">
                                <option value="blank">{{localize "PTU.SelectNone"}}</option>
                                {{selectOptions skills selected=actor.system.background.increased.one valueAttr="slug"}}
                            </select>
                        </div>
                        <div class="fb-33 center-text">
                            <select name="system.background.increased.two">
                                <option value="blank">{{localize "PTU.SelectNone"}}</option>
                                {{selectOptions skills selected=actor.system.background.increased.two valueAttr="slug"}}
                            </select>
                        </div>
                        <div class="fb-33 center-text">
                            <select name="system.background.increased.three">
                                <option value="blank">{{localize "PTU.SelectNone"}}</option>
                                {{selectOptions skills selected=actor.system.background.increased.three valueAttr="slug"}}
                            </select>
                        </div>
                    </div>
                    <div
                        class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-between">
                        <div class="fb-33">
                            <label for="system.background.decreased.one"><b>{{localize "PTU.SkillDown"}}
                                    1</b></label>
                        </div>
                        <div class="fb-33">
                            <label for="system.background.decreased.two"><b>{{localize "PTU.SkillDown"}}
                                    2</b></label>
                        </div>
                        <div class="fb-33">
                            <label for="system.background.decreased.three"><b>{{localize "PTU.SkillDown"}}
                                    3</b></label>
                        </div>
                    </div>
                    <div class="swsh-body mt-1 mb-1">
                        <div class="fb-33 center-text">
                            <select name="system.background.decreased.one">
                                <option value="blank">{{localize "PTU.SelectNone"}}</option>
                                {{selectOptions skills selected=actor.system.background.decreased.one valueAttr="slug"}}
                            </select>
                        </div>
                        <div class="fb-33 center-text">
                            <select name="system.background.decreased.two">
                                <option value="blank">{{localize "PTU.SelectNone"}}</option>
                                {{selectOptions skills selected=actor.system.background.decreased.two valueAttr="slug"}}
                            </select>
                        </div>
                        <div class="fb-33 center-text">
                            <select name="system.background.decreased.three">
                                <option value="blank">{{localize "PTU.SelectNone"}}</option>
                                {{selectOptions skills selected=actor.system.background.decreased.three valueAttr="slug"}}
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pe-col pe-col-side">
                <div class="swsh-box mb-2 w-100">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                        <b>Physical Traits</b>
                    </div>
                    <div class="swsh-body">
                        <textarea class="w-100" name="system.narrative.physicalTraits" rows="3">{{actor.system.narrative.physicalTraits}}</textarea>
                    </div>
                </div>

                <div class="swsh-box mb-2 w-100">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                        <b>Personality</b>
                    </div>
                    <div class="swsh-body">
                        <textarea class="w-100" name="system.narrative.personality" rows="3">{{actor.system.narrative.personality}}</textarea>
                    </div>
                </div>

                <div class="swsh-box mb-2 w-100">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                        <b>Motivations &amp; Interests</b>
                    </div>
                    <div class="swsh-body">
                        <textarea class="w-100" name="system.narrative.motivations" rows="3">{{actor.system.narrative.motivations}}</textarea>
                    </div>
                </div>

                <div class="swsh-box mb-2 w-100">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                        <b>Capture Context</b>
                    </div>
                    <div class="swsh-body">
                        <textarea class="w-100" name="system.narrative.captureContext" rows="3">{{actor.system.narrative.captureContext}}</textarea>
                    </div>
                </div>

                <div class="swsh-box mb-2 w-100">
                    <div class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-center">
                        <b>Pre-Campaign Lore</b>
                    </div>
                    <div class="swsh-body">
                        <textarea class="w-100" name="system.narrative.preCampaignLore" rows="3">{{actor.system.narrative.preCampaignLore}}</textarea>
                    </div>
                </div>
            </div>
            </div>
        </div>

        <!-- Mechanics -->
        <div class="tab details extra pe-tab" data-group="primary" data-tab="extra">
            <div class="pe-layout pe-halves">
            <div class="pe-col pe-col-main">
                <div class="swsh-box w-100 mb-2">
                    <div
                        class="swsh-header ball-themes {{ballStyle}} highlight pt-2 center-text justify-content-center">
                        <b>{{localize "PTU.Modifiers.Label"}}</b>
                    </div>
                    <div
                        class="swsh-header d-flex flex-row ball-themes {{ballStyle}} highlight pb-2 center-text justify-content-between">
                        <div class="fb-48">
                            <label for="system.modifiers.initiative.value"><b>{{localize "PTU.Initiative"}}
                                    {{localize "PTU.Bonus"}}</b></label>
                        </div>
                        <div class="fb-48">
                            <label for="system.modifiers.statPoints.value"><b>{{localize "PTU.StatPoint"}}
                                    {{localize "PTU.Bonus"}}</b></label>
                        </div>
                    </div>
                    <div class="swsh-body mt-1 mb-1 justify-content-between">
                        <div class="fb-48 center-text pl-2 pr-2">
                            {{> "systems/pe/static/templates/partials/mod-field.hbs"
                            mod=actor.system.modifiers.initiative.mod
                            path="system.modifiers.initiative.value"
                            value=actor.system.modifiers.initiative.value
                            total=actor.system.modifiers.initiative.total
                            dtype="Number"
                            modOrigins=(getProperty actor.origins "system.modifiers.initiative.mod")}}
                        </div>
                        <div class="fb-48 center-text pl-2 pr-2">
                            {{> "systems/pe/static/templates/partials/mod-field.hbs"
                            mod=actor.system.modifiers.statPoints.mod
                            path="system.modifiers.statPoints.value"
                            value=actor.system.modifiers.statPoints.value
                            total=actor.system.modifiers.statPoints.total
                            dtype="Number"
                            modOrigins=(getProperty actor.origins "system.modifiers.statPoints.mod")}}
                        </div>
                    </div>
                    <div
                        class="swsh-header d-flex flex-row ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-between">
                        <div class="fb-48">
                            <label for="system.modifiers.acBonus"><b>{{localize "PTU.Accuracy"}} {{localize
                                    "PTU.Bonus"}}</b></label>
                        </div>
                        <div class="fb-48">
                            <label for="system.modifiers.critRange"><b>{{localize "PTU.CritRange"}} {{localize
                                    "PTU.Bonus"}}</b></label>
                        </div>
                    </div>
                    <div class="swsh-body mt-1 mb-1 justify-content-between">
                        <div class="fb-48 center-text pl-2 pr-2">
                            {{> "systems/pe/static/templates/partials/mod-field.hbs"
                            mod=actor.system.modifiers.acBonus.mod
                            path="system.modifiers.acBonus.value"
                            value=actor.system.modifiers.acBonus.value
                            total=actor.system.modifiers.acBonus.total
                            dtype="Number"
                            modOrigins=(getProperty actor.origins "system.modifiers.acBonus.mod")}}
                        </div>
                        <div class="fb-48 center-text pl-2 pr-2">
                            {{> "systems/pe/static/templates/partials/mod-field.hbs"
                            mod=actor.system.modifiers.critRange.mod
                            path="system.modifiers.critRange.value"
                            value=actor.system.modifiers.critRange.value
                            total=actor.system.modifiers.critRange.total
                            dtype="Number"
                            modOrigins=(getProperty actor.origins "system.modifiers.critRange.mod")}}
                        </div>
                    </div>
                    <div
                        class="swsh-header d-flex flex-row ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-between">
                        <div class="fb-48 center-text pl-2 pr-2">
                            <label for="system.modifiers.effectRange.value"><b>{{localize "PTU.EffectRange"}}
                                    {{localize "PTU.Bonus"}}</b></label>
                        </div>
                        <div class="fb-48 center-text pl-2 pr-2">
                            <label for="system.modifiers.skillBonus.value"><b>{{localize "PTU.Skill"}} {{localize
                                    "PTU.Bonus"}}</b></label>
                        </div>
                    </div>
                    <div class="swsh-body mt-1 mb-1 justify-content-between">
                        <div class="fb-48 center-text pl-2 pr-2">
                            {{> "systems/pe/static/templates/partials/mod-field.hbs"
                            mod=actor.system.modifiers.effectRange.mod
                            path="system.modifiers.effectRange.value"
                            value=actor.system.modifiers.effectRange.value
                            total=actor.system.modifiers.effectRange.total
                            dtype="Number"
                            modOrigins=(getProperty actor.origins "system.modifiers.effectRange.mod")}}
                        </div>
                        <div class="fb-48 center-text pl-2 pr-2">
                            {{> "systems/pe/static/templates/partials/mod-field.hbs"
                            mod=actor.system.modifiers.skillBonus.mod
                            path="system.modifiers.skillBonus.value"
                            value=actor.system.modifiers.skillBonus.value
                            total=actor.system.modifiers.skillBonus.total
                            dtype="Number"
                            modOrigins=(getProperty actor.origins "system.modifiers.skillBonus.mod")}}
                        </div>
                    </div>
                    <div
                        class="swsh-header d-flex flex-row ball-themes {{ballStyle}} highlight pt-2 center-text justify-content-center">
                        <label for="system.modifiers.damageReduction"><b>{{localize
                                "PTU.DamageReduction"}}</b></label>
                    </div>
                    <div
                        class="swsh-header d-flex flex-row ball-themes {{ballStyle}} highlight pb-2 center-text justify-content-between">
                        <div class="fb-48">
                            <label for="system.modifiers.damageReduction.physical.value"><b>{{localize
                                    "PTU.Physical"}}</b></label>
                        </div>
                        <div class="fb-48">
                            <label for="system.modifiers.damageReduction.special.value"><b>{{localize
                                    "PTU.Special"}}</b></label>
                        </div>
                    </div>
                    <div class="swsh-body mt-1 mb-1 justify-content-between">
                        <div class="fb-48 center-text pl-2 pr-2">
                            {{> "systems/pe/static/templates/partials/mod-field.hbs"
                            mod=actor.system.modifiers.damageReduction.physical.mod
                            path="system.modifiers.damageReduction.physical.value"
                            value=actor.system.modifiers.damageReduction.physical.value
                            total=actor.system.modifiers.damageReduction.physical.total
                            dtype="Number"
                            modOrigins=(getProperty actor.origins "system.modifiers.damageReduction.physical.mod")}}
                        </div>
                        <div class="fb-48 center-text pl-2 pr-2">
                            {{> "systems/pe/static/templates/partials/mod-field.hbs"
                            mod=actor.system.modifiers.damageReduction.special.mod
                            path="system.modifiers.damageReduction.special.value"
                            value=actor.system.modifiers.damageReduction.special.value
                            total=actor.system.modifiers.damageReduction.special.total
                            dtype="Number"
                            modOrigins=(getProperty actor.origins "system.modifiers.damageReduction.special.mod")}}
                        </div>
                    </div>
                </div>

                {{#if (isGm)}}
                <!-- Boss Settings -->
                <div class="swsh-box mb-2 w-100">
                    <div
                        class="swsh-header ball-themes {{ballStyle}} highlight pt-2 pb-2 center-text justify-content-evenly align-items-center">
                        <div class="fb-33">
                            <label for="system.boss.is"><b>{{localize "PTU.BossIs"}}</b></label>
                        </div>
                        <div class="fb-33">
                            <label for="system.boss.turns"><b>{{localize "PTU.BossTurns"}}</b></label>
                        </div>
                        <div class="fb-33">
                            <label for="system.boss.bars"><b>{{localize "PTU.BossBars"}}</b></label>
                        </div>
                    </div>
                    <div class="swsh-body mt-1 mb-1 justify-content-evenly">
                        <div class="fb-33 center-text">
                            <input name="system.boss.is" type="checkbox" {{checked actor.system.boss.is}} />
                        </div>
                        <div class="fb-33 center-text">
                            <input name="system.boss.turns" type="number" data-dtype="Number"
                                value="{{actor.system.boss.turns}}" />
                        </div>
                        <div class="fb-33 center-text">
                            <input name="system.boss.bars" type="number" data-dtype="Number"
                                value="{{actor.system.boss.bars}}" />
                        </div>
                    </div>
                </div>
                {{/if}}
            </div>

            <div class="pe-col pe-col-side"></div>
            </div>
        </div>
    </main>
</form>
