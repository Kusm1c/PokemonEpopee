<div class="form-group">
    <label class="short">{{localize "PTU.RuleEditor.General.Domain"}}</label>
    <div class="spaced-fields details-container-flex-row">
        <input type="text" name="system.rules.{{index}}.domain" value="{{rule.domain}}" placeholder="{{peLocalize "PTU.Epopee.Rules.DomainAll"}}"/>
    </div>
</div>

<div class="form-group">
    <label class="short">{{localize "PTU.RuleEditor.General.Option"}}</label>
    <div class="spaced-fields details-container-flex-row">
        <input type="text" name="system.rules.{{index}}.option" value="{{rule.option}}" placeholder="{{peLocalize "PTU.Epopee.Rules.RollOption"}}"/>
    </div>
</div>

<div class="form-group">
    <label class="short">{{localize "PTU.RuleEditor.General.Value"}}</label>
    <div class="spaced-fields details-container-flex-row">
        <input type="text" name="system.rules.{{index}}.value" value="{{rule.value}}" placeholder="{{peLocalize "PTU.Epopee.Rules.ValueTrue"}}"/>
    </div>
</div>

