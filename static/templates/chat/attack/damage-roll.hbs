<div class="dice-shadow {{#if crit.hit}}crit {{#unless crit.show}}hidden{{/unless}}{{/if}}">
    {{#if crit.hit}}
    <span class="flavor-text">
        <div class="header-bar tags">
            <span class="tag tag-transparent" data-slug="crit-double-mod">{{peLocalize "PTU.Epopee.Chat.CritDoubles"}}</span>
        </div>
    </span>
    {{/if}}
    <div class="dice-roll attack-roll attack">
        <div class="dice-result">
            <div class="dice-formula">{{formula}}</div>
            {{{tooltip}}}
            <div class="dice-total">
                <span class="num-total">{{#if crit.hit}}{{peLocalize "PTU.Epopee.Chat.CritDamage" total=@root/total}}{{else}}{{peLocalize "PTU.Epopee.Chat.Damage" total=@root/total}}{{/if}}</span>
            </div>
        </div>
    </div>
</div>