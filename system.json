{
  "id": "pe",
  "title": "PokemonEpopee",
  "description": "Homebrew fork of the Pokemon Tabletop Reunited (PTR) system for FoundryVTT, with custom rules (travel/exploration, status engine, environmental modifiers).",
  "compatibility": {
    "minimum": "13.345",
    "verified": "14.365"
  },
  "version": "0.1.1",
  "templateVersion": 2,
  "authors": [
    {
      "name": "Ashe Eon",
      "email": "pe@soaringnetwork.com",
      "url": "https://github.com/dylanpiera/Foundry-Pokemon-Tabletop-United-System"
    },
    {
      "name": "Ellam Fox"
    },
    {
      "name": "Muhsigbokz"
    },
    {
      "name": "Silverfox3853",
      "url": "https://startplaying.games/gm/fox-the-gm"
    },
    {
      "name": "TitaniumDragoonNeo"
    },
    {
      "name": "Sajochi",
      "url": "https://www.youtube.com/channel/UCiUTs4FV0HtdoziFogJAdEw"
    },
    {
      "name": "UmcaraAí",
      "url": "https://github.com/p-arth"
    }
  ],
  "esmodules": ["src/ptr.js"],
  "socket": true,
  "styles": [
    "static/css/fonts.css",
    "static/css/utils.css",
    "static/css/main.css",
    "static/css/tooltipster.css",
    "static/css/progress-bar.css",
    "static/css/tagify.css",
    "static/css/nouislider.css",
    "static/css/slider.css"
  ],
  "scripts": [
    "static/js/tooltipster.js",
    "static/js/tagify",
    "static/js/tagify.polyfills.min.js",
    "static/js/minisearch.index.min.js"
  ],
  "flags": {
    "hotReload": {
      "extensions": ["css", "js", "hbs", "json"]
    }
  },
  "packs": [
    {
      "label": "PTR Abilities",
      "type": "Item",
      "name": "abilities",
      "path": "packs/abilities.db",
      "system": "pe"
    },
    {
      "label": "PTR Moves",
      "type": "Item",
      "name": "moves",
      "path": "packs/moves.db",
      "system": "pe"
    },
    {
      "label": "PTR Feats",
      "type": "Item",
      "name": "feats",
      "path": "packs/feats.db",
      "system": "pe"
    },
    {
      "label": "PTR Edges",
      "type": "Item",
      "name": "edges",
      "path": "packs/edges.db",
      "system": "pe"
    },
    {
      "label": "PTR Items",
      "type": "Item",
      "name": "items",
      "path": "packs/items.db",
      "system": "pe"
    },
    {
      "label": "PTR Capabilities",
      "type": "Item",
      "name": "capabilities",
      "path": "packs/capabilities.db",
      "system": "pe"
    },
    {
      "label": "PTR Poke Edges",
      "type": "Item",
      "name": "poke-edges",
      "path": "packs/poke-edges.db",
      "system": "pe"
    },
    {
      "label": "PTR Habitats",
      "type": "RollTable",
      "name": "habitats",
      "path": "packs/habitats.db",
      "system": "pe"
    },
    {
      "label": "PTR Rolltables",
      "type": "RollTable",
      "name": "rolltables",
      "system": "pe"
    },
    {
      "label": "PTR Effects",
      "type": "Item",
      "name": "effects",
      "path": "packs/effects.db",
      "system": "pe"
    },
    {
      "label": "PTR Species",
      "type": "Item",
      "name": "species",
      "path": "packs/species.db",
      "system": "pe"
    }, 
    {
      "label": "PTR Macros",
      "type": "Macro",
      "name": "macros",
      "system": "pe"
    },
    {
      "label": "PTR References",
      "type": "Item",
      "name": "references",
      "system": "pe"
