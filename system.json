    {
      "label": "PTR Spirit Actions",
      "type": "Item",
      "name": "spirit-actions",
      "system": "pe"
    },
    {
      "label": "PTR Journals",
      "type": "JournalEntry",
      "name": "journals",
      "system": "pe"
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "static/lang/en.json"
    },
    {
      "lang": "es",
      "name": "Spanish",
      "path": "static/lang/es.json"
    }
  ],
  "packFolders": [
    {
      "name": "Rolltables",
      "sorting": "m",
      "color": "#89a380",
      "packs": ["habitats", "rolltables"]
    },
    {
      "name": "Items",
      "sorting": "a",
      "color": "#9c85b7",
      "packs": ["abilities", "capabilities", "items", "moves"],
      "folders": [
        {
          "name": "Trainer",
          "sorting": "a",
          "color": "#4b98d2",
          "packs": ["edges", "feats"]
        },
        {
          "name": "Pokemon",
          "sorting": "a",
          "color": "#d26565",
          "packs": ["poke-edges", "species", "spirit-actions"]
        }
      ]
    },
    {
      "name": "Automation & Information",
      "sorting": "m",
      "color": "#89a380",
      "packs": ["journals", "references", "macros", "effects"]
    }
  ],
  "background": "systems/pe/static/images/banner.webp",
  "url": "https://github.com/Kusm1c/PokemonEpopee",
  "manifest": "https://raw.githubusercontent.com/Kusm1c/PokemonEpopee/main/system.json",
  "download": "https://github.com/Kusm1c/PokemonEpopee/archive/refs/heads/main.zip"
}
